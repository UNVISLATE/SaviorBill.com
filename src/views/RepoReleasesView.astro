---
import { marked } from 'marked';
import BaseLayout from '../layouts/BaseLayout.astro';
import repositories from '../data/repositories.json';
import releasesCache from '../data/releases-cache.json';
import { getLocalePath } from '../i18n/ui';

interface Props {
  lang: 'ru' | 'en';
  repoId: string;
}

const { lang, repoId } = Astro.props;

const repoConfig = repositories.find((r) => r.id === repoId);
if (!repoConfig) {
  throw new Error(`Unknown repository id: ${repoId}`);
}

type CachedContainer = {
  name: string;
  label: string;
  image: string;
  tag: string;
  aliases?: string[];
  pullCommand: string;
  digest: string | null;
  platforms: string[];
  packageUrl: string;
};

type CachedAsset = {
  name: string;
  size: number;
  downloadCount: number;
  browserDownloadUrl: string;
};

type CachedRelease = {
  id: number;
  tagName: string;
  name: string;
  body: string;
  htmlUrl: string;
  publishedAt: string;
  prerelease: boolean;
  assets: CachedAsset[];
  containers: CachedContainer[];
};

type CachedRepo = {
  id: string;
  owner: string;
  repo: string;
  htmlUrl: string;
  stars: number;
  releases: CachedRelease[];
  fetchedAt: string | null;
};

const cacheMap = (releasesCache as { repositories?: Record<string, CachedRepo> }).repositories || {};
const cached = cacheMap[repoId];
const stars = cached?.stars ?? 0;
const releases = (cached?.releases || []).map((rel) => ({
  ...rel,
  renderedBody: rel.body ? marked.parse(rel.body, { async: false, gfm: true, breaks: true }) : '',
}));
const latestStableId = releases.find((r) => !r.prerelease)?.id ?? null;

const title =
  lang === 'ru'
    ? `Релизы ${repoConfig.name}`
    : `${repoConfig.name} Releases`;
const description = repoConfig.description[lang];
const repoUrl = cached?.htmlUrl || `https://github.com/${repoConfig.owner}/${repoConfig.repo}`;

function formatDate(iso: string | undefined) {
  if (!iso) return '';
  return iso.split('T')[0];
}

function formatBytes(bytes: number) {
  if (!bytes) return '0 B';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return `${(bytes / Math.pow(k, i)).toFixed(1)} ${sizes[i]}`;
}
---

<BaseLayout title={title} description={description} lang={lang}>
  <div class="px-3 sm:px-4 py-10 sm:py-14">
    <div class="max-w-5xl mx-auto space-y-8">

      <!-- Breadcrumbs -->
      <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 text-xs font-mono text-[oklch(0.55_0_0)] article-breadcrumbs">
        <a href={getLocalePath('/', lang)} class="hover:text-[#009080] transition-colors">SaviorBill</a>
        <span>/</span>
        <a href={getLocalePath('/releases', lang)} class="hover:text-[#009080] transition-colors">
          {lang === 'ru' ? 'Релизы' : 'Releases'}
        </a>
        <span>/</span>
        <span class="text-[#009080]">{repoConfig.name}</span>
      </div>

      <!-- Repository Header Card -->
      <div class="rounded-2xl bg-[oklch(0.19_0_0)] light:bg-white shadow-xl p-6 sm:p-8 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
          <div class="space-y-2">
            <div class="flex flex-wrap items-center gap-2">
              <span class="badge-pill px-2.5 py-0.5 rounded text-[11px] font-mono font-semibold">
                {repoConfig.badge[lang]}
              </span>
              <span class="text-xs font-mono text-[oklch(0.6_0_0)]">
                {repoConfig.owner}/{repoConfig.repo}
              </span>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 text-[11px] font-mono font-semibold">
                <svg class="size-3 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                </svg>
                <span>{stars}</span>
              </span>
            </div>
            <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white">
              {repoConfig.name}
            </h1>
            <p class="text-sm text-[oklch(0.7_0_0)] leading-relaxed max-w-2xl">
              {repoConfig.description[lang]}
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2 shrink-0">
            <a
              href={repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="h-10 px-4 rounded-xl bg-[oklch(0.24_0_0)] hover:bg-[oklch(0.28_0_0)] text-white text-xs font-semibold inline-flex items-center gap-2 transition-colors"
            >
              <svg class="size-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span>GitHub</span>
              <span class="opacity-60">↗</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Search Filter -->
      {releases.length > 0 && (
        <div class="relative max-w-md">
          <input
            type="text"
            id="release-search-input"
            placeholder={lang === 'ru' ? 'Фильтр по тегу, описанию или образу...' : 'Filter by tag, notes, or image...'}
            autocomplete="off"
            class="w-full h-11 pl-10 pr-4 rounded-xl bg-[oklch(0.20_0_0)] text-sm text-white placeholder-[oklch(0.55_0_0)] focus:outline-none focus:ring-1 focus:ring-[#009080] transition-all shadow-sm"
          />
          <svg class="size-4 text-[oklch(0.55_0_0)] absolute left-3.5 top-3.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      )}

      <!-- Empty State -->
      {releases.length === 0 ? (
        <div class="rounded-2xl bg-[oklch(0.19_0_0)] light:bg-white shadow-xl p-10 text-center space-y-3">
          <p class="text-base font-semibold text-white">
            {lang === 'ru' ? 'Опубликованных релизов пока нет' : 'No published releases yet'}
          </p>
          <p class="text-xs text-[oklch(0.65_0_0)] max-w-md mx-auto">
            {lang === 'ru'
              ? 'Как только в репозитории появится первый GitHub Release, он автоматически отобразится на этой странице.'
              : 'As soon as the first GitHub Release is published in this repository, it will appear here automatically.'}
          </p>
          <div class="pt-2">
            <a
              href={`${repoUrl}/releases`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#009080] hover:bg-[#0c5e53] text-white text-xs font-semibold transition-colors"
            >
              <span>{lang === 'ru' ? 'Открыть GitHub Releases' : 'Open GitHub Releases'}</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      ) : (
        <div id="releases-list" class="space-y-6">
          {releases.map((rel) => {
            const isLatest = rel.id === latestStableId;
            const searchText = `${rel.tagName} ${rel.name} ${rel.body} ${rel.containers.map((c) => `${c.name} ${c.image} ${(c.aliases || []).join(' ')}`).join(' ')}`.toLowerCase();

            return (
              <section
                data-release-card
                data-search-text={searchText}
                class="rounded-2xl bg-[oklch(0.19_0_0)] light:bg-white shadow-xl p-6 sm:p-8 space-y-5"
              >
                <!-- Release Header -->
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-4 border-b border-[oklch(1_0_0/6%)]">
                  <div class="space-y-1.5">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="px-2.5 py-0.5 rounded-lg bg-[#009080]/15 text-[#009080] text-xs font-mono font-bold">
                        {rel.tagName}
                      </span>
                      {isLatest && (
                        <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 text-[11px] font-mono font-semibold">
                          Latest
                        </span>
                      )}
                      {rel.prerelease && (
                        <span class="px-2.5 py-0.5 rounded-full bg-amber-500/15 text-amber-400 text-[11px] font-mono font-semibold">
                          Pre-release
                        </span>
                      )}
                      {rel.publishedAt && (
                        <time datetime={rel.publishedAt} class="text-xs font-mono text-[oklch(0.6_0_0)]">
                          {formatDate(rel.publishedAt)}
                        </time>
                      )}
                    </div>
                    <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
                      {rel.name}
                    </h2>
                  </div>

                  <a
                    href={rel.htmlUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[oklch(0.22_0_0)] hover:bg-[oklch(0.27_0_0)] text-xs font-mono text-[oklch(0.85_0_0)] hover:text-white transition-colors shrink-0 self-start sm:self-center"
                  >
                    <span>GitHub Release</span>
                    <span>↗</span>
                  </a>
                </div>

                <!-- Release Notes (Markdown) -->
                {rel.renderedBody ? (
                  <div class="article-content text-sm" set:html={rel.renderedBody} />
                ) : (
                  <p class="text-xs italic text-[oklch(0.55_0_0)]">
                    {lang === 'ru' ? 'Описание релиза не указано.' : 'No release notes provided.'}
                  </p>
                )}

                <!-- Linked Container Builds (GHCR) -->
                {rel.containers.length > 0 && (
                  <div class="pt-4 border-t border-[oklch(1_0_0/6%)] space-y-3">
                    <div class="flex items-center justify-between gap-2">
                      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-[oklch(0.75_0_0)] flex items-center gap-2">
                        <span class="size-2 rounded-full bg-[#009080]"></span>
                        {lang === 'ru'
                          ? `Связанные сборки контейнеров (${rel.containers.length})`
                          : `Linked Container Builds (${rel.containers.length})`}
                      </h3>
                    </div>

                    <div class="grid grid-cols-1 gap-2.5">
                      {rel.containers.map((c) => (
                        <div class="rounded-xl bg-[oklch(0.16_0_0)] p-3 sm:p-3.5 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                          <div class="space-y-1 min-w-0">
                            <div class="flex flex-wrap items-center gap-2">
                              <a
                                href={c.packageUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-xs font-semibold text-white hover:text-[#009080] transition-colors"
                              >
                                {c.label}
                              </a>
                              <span class="px-2 py-0.5 rounded bg-[#009080]/15 text-[#009080] text-[10px] font-mono font-semibold">
                                {c.tag}
                              </span>
                              {(c.aliases || []).map((alias) => (
                                <span
                                  class={`px-2 py-0.5 rounded text-[10px] font-mono font-semibold ${
                                    alias === 'latest'
                                      ? 'bg-emerald-500/15 text-emerald-400'
                                      : 'bg-purple-500/15 text-purple-400'
                                  }`}
                                >
                                  {alias}
                                </span>
                              ))}
                              {c.platforms.map((p) => (
                                <span class="px-1.5 py-0.5 rounded bg-[oklch(0.22_0_0)] text-[10px] font-mono text-[oklch(0.7_0_0)]">
                                  {p}
                                </span>
                              ))}
                              {c.digest && (
                                <span class="text-[10px] font-mono text-[oklch(0.5_0_0)]" title={c.digest}>
                                  {c.digest.slice(0, 19)}…
                                </span>
                              )}
                            </div>
                            <code class="block text-[11px] font-mono text-[oklch(0.72_0_0)] truncate">
                              {c.pullCommand}
                            </code>
                          </div>

                          <button
                            type="button"
                            data-copy-cmd={c.pullCommand}
                            class="copy-pull-btn h-8 px-3 rounded-lg bg-[oklch(0.24_0_0)] hover:bg-[#009080] text-white text-[11px] font-mono font-semibold transition-colors cursor-pointer shrink-0 self-start md:self-center"
                          >
                            {lang === 'ru' ? 'Копировать' : 'Copy'}
                          </button>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                <!-- Release Assets -->
                {rel.assets.length > 0 && (
                  <div class="pt-4 border-t border-[oklch(1_0_0/6%)] space-y-2.5">
                    <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-[oklch(0.75_0_0)]">
                      {lang === 'ru' ? 'Файлы релиза' : 'Release Assets'}
                    </h3>
                    <div class="flex flex-wrap gap-2">
                      {rel.assets.map((asset) => (
                        <a
                          href={asset.browserDownloadUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-[oklch(0.16_0_0)] hover:bg-[oklch(0.22_0_0)] text-xs font-mono text-[oklch(0.85_0_0)] hover:text-[#009080] transition-colors"
                        >
                          <span>{asset.name}</span>
                          <span class="text-[10px] text-[oklch(0.55_0_0)]">({formatBytes(asset.size)})</span>
                        </a>
                      ))}
                    </div>
                  </div>
                )}
              </section>
            );
          })}
        </div>
      )}

      <div id="release-no-results" class="hidden text-center py-12 space-y-2">
        <p class="text-base font-semibold text-white">
          {lang === 'ru' ? 'Релизы не найдены' : 'No matching releases found'}
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    function initReleasesPage() {
      const searchInput = document.getElementById('release-search-input');
      const cards = document.querySelectorAll('[data-release-card]');
      const noResults = document.getElementById('release-no-results');

      if (searchInput && !searchInput.dataset.bound) {
        searchInput.dataset.bound = 'true';
        searchInput.addEventListener('input', function () {
          const q = searchInput.value.trim().toLowerCase();
          let visible = 0;
          cards.forEach(function (card) {
            const hay = card.getAttribute('data-search-text') || '';
            const match = !q || hay.includes(q);
            card.classList.toggle('hidden', !match);
            if (match) visible++;
          });
          if (noResults) {
            noResults.classList.toggle('hidden', visible > 0);
          }
        });
      }

      document.querySelectorAll('.copy-pull-btn').forEach(function (btn) {
        if (btn.dataset.bound) return;
        btn.dataset.bound = 'true';
        btn.addEventListener('click', function () {
          const cmd = btn.getAttribute('data-copy-cmd') || '';
          if (!cmd) return;
          navigator.clipboard.writeText(cmd).then(function () {
            const orig = btn.textContent;
            btn.textContent = document.documentElement.lang === 'en' ? 'Copied!' : 'Скопировано!';
            btn.classList.add('bg-[#009080]');
            setTimeout(function () {
              btn.textContent = orig;
              btn.classList.remove('bg-[#009080]');
            }, 1500);
          });
        });
      });
    }

    initReleasesPage();
    document.addEventListener('astro:after-swap', initReleasesPage);
  })();
</script>
