---
import { marked } from 'marked';
import BaseLayout from '../layouts/BaseLayout.astro';
import repositories from '../data/repositories.json';
import releasesCache from '../data/releases-cache.json';
import { getLocalePath } from '../i18n/ui';
import { getReleasePageSlice } from '../utils/releases-pagination';

interface Props {
  lang: 'ru' | 'en';
  repoId: string;
  page?: number;
}

const { lang, repoId, page = 1 } = Astro.props;

const repoConfig = repositories.find((r) => r.id === repoId);
if (!repoConfig) {
  throw new Error(`Unknown repository id: ${repoId}`);
}

type CachedContainer = {
  name: string;
  label: string;
  image: string;
  tag: string;
  aliases?: string[];
  pullCommand: string;
  digest: string | null;
  platforms: string[];
  packageUrl: string;
};

type CachedRelease = {
  id: number;
  tagName: string;
  name: string;
  body: string;
  htmlUrl: string;
  publishedAt: string;
  prerelease: boolean;
  assets: Array<{ name: string; size: number }>;
  containers: CachedContainer[];
};

type CachedRepo = {
  id: string;
  owner: string;
  repo: string;
  htmlUrl: string;
  stars: number;
  releases: CachedRelease[];
  fetchedAt: string | null;
};

const cacheMap = (releasesCache as { repositories?: Record<string, CachedRepo> }).repositories || {};
const cached = cacheMap[repoId];
const stars = cached?.stars ?? 0;
const allReleases = cached?.releases || [];
const latestStableId = allReleases.find((r) => !r.prerelease)?.id ?? null;

const { featured, gridItems, totalPages, currentPage } = getReleasePageSlice(allReleases, page);

const title =
  currentPage > 1
    ? lang === 'ru'
      ? `Релизы ${repoConfig.name} — стр. ${currentPage}`
      : `${repoConfig.name} Releases — Page ${currentPage}`
    : lang === 'ru'
      ? `Релизы ${repoConfig.name}`
      : `${repoConfig.name} Releases`;
const description = repoConfig.description[lang];
const repoUrl = cached?.htmlUrl || `https://github.com/${repoConfig.owner}/${repoConfig.repo}`;

function formatDate(iso: string | undefined) {
  if (!iso) return '';
  return iso.split('T')[0];
}

function toMarkdownExcerpt(md: string, maxLines = 6, maxChars = 420): string {
  if (!md) return '';
  const lines = md.trim().split(/\r?\n/);
  const sliced = lines.slice(0, maxLines).join('\n');
  if (sliced.length <= maxChars && lines.length <= maxLines) {
    return sliced;
  }
  return `${sliced.slice(0, maxChars).trimEnd()}…`;
}

function toPlainPreview(md: string, maxLen = 140): string {
  if (!md) return '';
  const plain = md
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`([^`]+)`/g, '$1')
    .replace(/!\[.*?\]\(.*?\)/g, '')
    .replace(/\[([^\]]+)\]\(.*?\)/g, '$1')
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/^[\s]*[-*+]\s+/gm, '• ')
    .replace(/[*_~]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  if (plain.length <= maxLen) return plain;
  return `${plain.slice(0, maxLen).trimEnd()}…`;
}

function pageHref(p: number) {
  if (p <= 1) return getLocalePath(`/releases/${repoConfig!.id}`, lang);
  return getLocalePath(`/releases/${repoConfig!.id}/page/${p}`, lang);
}
---

<BaseLayout title={title} description={description} lang={lang}>
  <div class="px-3 sm:px-4 py-10 sm:py-14">
    <div class="max-w-6xl mx-auto space-y-8">

      <!-- Breadcrumbs -->
      <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 text-xs font-mono text-[oklch(0.55_0_0)] article-breadcrumbs">
        <a href={getLocalePath('/', lang)} class="hover:text-[#009080] transition-colors">SaviorBill</a>
        <span>/</span>
        <a href={getLocalePath('/releases', lang)} class="hover:text-[#009080] transition-colors">
          {lang === 'ru' ? 'Релизы' : 'Releases'}
        </a>
        <span>/</span>
        <span class="text-[#009080]">{repoConfig.name}</span>
        {currentPage > 1 && (
          <>
            <span>/</span>
            <span>{lang === 'ru' ? `Стр. ${currentPage}` : `Page ${currentPage}`}</span>
          </>
        )}
      </div>

      <!-- Repository Header Card (static, no hover lift) -->
      <div class="rounded-2xl bg-[oklch(0.19_0_0)] light:bg-white shadow-xl p-6 sm:p-8 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
          <div class="space-y-2">
            <div class="flex flex-wrap items-center gap-2">
              <span class="badge-pill px-2.5 py-0.5 rounded text-[11px] font-mono font-semibold">
                {repoConfig.badge[lang]}
              </span>
              <span class="text-xs font-mono text-[oklch(0.6_0_0)]">
                {repoConfig.owner}/{repoConfig.repo}
              </span>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 text-[11px] font-mono font-semibold">
                <svg class="size-3 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                </svg>
                <span>{stars}</span>
              </span>
            </div>
            <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white">
              {repoConfig.name}
            </h1>
            <p class="text-sm text-[oklch(0.7_0_0)] leading-relaxed max-w-2xl">
              {repoConfig.description[lang]}
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2 shrink-0">
            <a
              href={repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="h-10 px-4 rounded-xl bg-[oklch(0.24_0_0)] hover:bg-[oklch(0.28_0_0)] text-white text-xs font-semibold inline-flex items-center gap-2 transition-colors"
            >
              <svg class="size-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span>GitHub</span>
              <span class="opacity-60">↗</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Empty State -->
      {allReleases.length === 0 ? (
        <div class="rounded-2xl bg-[oklch(0.19_0_0)] light:bg-white shadow-xl p-10 text-center space-y-3">
          <p class="text-base font-semibold text-white">
            {lang === 'ru' ? 'Опубликованных релизов пока нет' : 'No published releases yet'}
          </p>
          <p class="text-xs text-[oklch(0.65_0_0)] max-w-md mx-auto">
            {lang === 'ru'
              ? 'Как только в репозитории появится первый GitHub Release, он автоматически отобразится на этой странице.'
              : 'As soon as the first GitHub Release is published in this repository, it will appear here automatically.'}
          </p>
          <div class="pt-2">
            <a
              href={`${repoUrl}/releases`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#009080] hover:bg-[#0c5e53] text-white text-xs font-semibold transition-colors"
            >
              <span>{lang === 'ru' ? 'Открыть GitHub Releases' : 'Open GitHub Releases'}</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      ) : (
        <div class="space-y-6">

          <!-- Featured Latest Release (Page 1 only, full width, whole card clickable) -->
          {featured && (() => {
            const isLatest = featured.id === latestStableId;
            const excerptMd = toMarkdownExcerpt(featured.body, 6, 420);
            const renderedExcerpt = excerptMd
              ? marked.parse(excerptMd, { async: false, gfm: true, breaks: true })
              : '';
            const detailUrl = getLocalePath(`/releases/${repoConfig.id}/${featured.tagName}`, lang);

            return (
              <article class="relative group card-interactive rounded-2xl p-6 sm:p-8 space-y-4 transition-all duration-300">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-4 border-b border-[oklch(1_0_0/6%)]">
                  <div class="space-y-1.5">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="px-2.5 py-0.5 rounded-lg bg-[#009080]/15 text-[#009080] text-xs font-mono font-bold">
                        {featured.tagName}
                      </span>
                      {isLatest && (
                        <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 text-[11px] font-mono font-semibold">
                          Latest
                        </span>
                      )}
                      {featured.prerelease && (
                        <span class="px-2.5 py-0.5 rounded-full bg-amber-500/15 text-amber-400 text-[11px] font-mono font-semibold">
                          Pre-release
                        </span>
                      )}
                      {featured.publishedAt && (
                        <time datetime={featured.publishedAt} class="text-xs font-mono text-[oklch(0.6_0_0)]">
                          {formatDate(featured.publishedAt)}
                        </time>
                      )}
                    </div>
                    <h2 class="text-xl sm:text-2xl font-bold text-white group-hover:text-[#009080] transition-colors tracking-tight">
                      <a href={detailUrl} class="after:absolute after:inset-0 after:z-0 focus:outline-none">
                        {featured.name}
                      </a>
                    </h2>
                  </div>

                  <div class="relative z-10 flex items-center gap-2 shrink-0 self-start sm:self-center">
                    <a
                      href={featured.htmlUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={lang === 'ru' ? 'Открыть релиз на GitHub' : 'Open release on GitHub'}
                      aria-label="GitHub Release"
                      class="size-9 rounded-xl bg-[oklch(0.24_0_0)] hover:bg-[oklch(0.30_0_0)] text-[oklch(0.85_0_0)] hover:text-white inline-flex items-center justify-center transition-colors"
                    >
                      <svg class="size-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                      </svg>
                    </a>
                    <a
                      href={detailUrl}
                      class="h-9 px-4 rounded-xl bg-[#009080] hover:bg-[#0c5e53] text-white text-xs font-semibold inline-flex items-center gap-2 transition-colors"
                    >
                      <span>{lang === 'ru' ? 'Страница релиза' : 'Release page'}</span>
                      <span class="font-mono">→</span>
                    </a>
                  </div>
                </div>

                {renderedExcerpt && (
                  <div class="article-content text-sm [&_a]:relative [&_a]:z-10" set:html={renderedExcerpt} />
                )}

                <div class="pt-2 flex items-center justify-between text-xs font-mono text-[oklch(0.6_0_0)]">
                  <span>
                    {featured.containers.length > 0
                      ? `${featured.containers.length} ${lang === 'ru' ? 'образов GHCR' : 'GHCR images'}`
                      : ''}
                  </span>
                  <span class="text-[#009080] font-semibold inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
                    <span>{lang === 'ru' ? 'Читать далее' : 'Read more'}</span>
                    <span>→</span>
                  </span>
                </div>
              </article>
            );
          })()}

          <!-- Compact 3-Column Releases Grid -->
          {gridItems.length > 0 && (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
              {gridItems.map((rel) => {
                const isLatest = rel.id === latestStableId;
                const preview = toPlainPreview(rel.body, 140);
                const detailUrl = getLocalePath(`/releases/${repoConfig.id}/${rel.tagName}`, lang);
                const hasLatestAlias = rel.containers.some((c) => (c.aliases || []).includes('latest'));
                const hasNightlyAlias = rel.containers.some((c) => (c.aliases || []).includes('nightly'));

                return (
                  <a
                    href={detailUrl}
                    class="group card-interactive flex flex-col justify-between rounded-2xl p-5 transition-all duration-300"
                  >
                    <div class="space-y-3">
                      <div class="flex flex-wrap items-center justify-between gap-2">
                        <div class="flex flex-wrap items-center gap-1.5">
                          <span class="px-2 py-0.5 rounded-md bg-[#009080]/15 text-[#009080] text-[11px] font-mono font-bold">
                            {rel.tagName}
                          </span>
                          {isLatest && (
                            <span class="px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 text-[10px] font-mono font-semibold">
                              Latest
                            </span>
                          )}
                          {rel.prerelease && (
                            <span class="px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-400 text-[10px] font-mono font-semibold">
                              Pre-release
                            </span>
                          )}
                          {hasLatestAlias && !isLatest && (
                            <span class="px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-400 text-[10px] font-mono font-semibold">
                              latest
                            </span>
                          )}
                          {hasNightlyAlias && (
                            <span class="px-1.5 py-0.5 rounded bg-purple-500/15 text-purple-400 text-[10px] font-mono font-semibold">
                              nightly
                            </span>
                          )}
                        </div>
                        {rel.publishedAt && (
                          <time datetime={rel.publishedAt} class="text-[11px] font-mono text-[oklch(0.55_0_0)]">
                            {formatDate(rel.publishedAt)}
                          </time>
                        )}
                      </div>

                      <h3 class="text-base font-bold text-white group-hover:text-[#009080] transition-colors tracking-tight line-clamp-2">
                        {rel.name}
                      </h3>

                      {preview && (
                        <p class="text-xs text-[oklch(0.66_0_0)] leading-relaxed line-clamp-3">
                          {preview}
                        </p>
                      )}
                    </div>

                    <div class="mt-4 pt-3 border-t border-[oklch(1_0_0/6%)] flex items-center justify-between text-[11px] font-mono">
                      <span class="text-[oklch(0.55_0_0)]">
                        {rel.containers.length > 0
                          ? `${rel.containers.length} ${lang === 'ru' ? 'контейнеров' : 'containers'}`
                          : lang === 'ru'
                            ? 'Открыть релиз'
                            : 'View release'}
                      </span>
                      <span class="text-[#009080] font-semibold group-hover:translate-x-0.5 transition-transform">
                        →
                      </span>
                    </div>
                  </a>
                );
              })}
            </div>
          )}

          <!-- Pagination -->
          {totalPages > 1 && (
            <nav aria-label="Pagination" class="flex items-center justify-center gap-2 pt-4">
              {currentPage > 1 && (
                <a
                  href={pageHref(currentPage - 1)}
                  class="h-9 px-3.5 rounded-xl bg-[oklch(0.20_0_0)] hover:bg-[#009080] text-xs font-mono text-white transition-colors inline-flex items-center gap-1.5"
                >
                  <span>←</span>
                  <span>{lang === 'ru' ? 'Назад' : 'Prev'}</span>
                </a>
              )}

              <div class="flex items-center gap-1.5">
                {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
                  <a
                    href={pageHref(p)}
                    aria-current={p === currentPage ? 'page' : undefined}
                    class={`size-9 rounded-xl text-xs font-mono font-semibold inline-flex items-center justify-center transition-colors ${
                      p === currentPage
                        ? 'bg-[#009080] text-white'
                        : 'bg-[oklch(0.20_0_0)] hover:bg-[oklch(0.26_0_0)] text-[oklch(0.75_0_0)] hover:text-white'
                    }`}
                  >
                    {p}
                  </a>
                ))}
              </div>

              {currentPage < totalPages && (
                <a
                  href={pageHref(currentPage + 1)}
                  class="h-9 px-3.5 rounded-xl bg-[oklch(0.20_0_0)] hover:bg-[#009080] text-xs font-mono text-white transition-colors inline-flex items-center gap-1.5"
                >
                  <span>{lang === 'ru' ? 'Вперёд' : 'Next'}</span>
                  <span>→</span>
                </a>
              )}
            </nav>
          )}

        </div>
      )}
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    function bindCopyButtons() {
      document.querySelectorAll('.copy-pull-btn').forEach(function (btn) {
        if (btn.dataset.bound) return;
        btn.dataset.bound = 'true';
        btn.addEventListener('click', function () {
          const cmd = btn.getAttribute('data-copy-cmd') || '';
          if (!cmd) return;
          navigator.clipboard.writeText(cmd).then(function () {
            const orig = btn.textContent;
            btn.textContent = document.documentElement.lang === 'en' ? 'Copied!' : 'Скопировано!';
            btn.classList.add('bg-[#009080]');
            setTimeout(function () {
              btn.textContent = orig;
              btn.classList.remove('bg-[#009080]');
            }, 1500);
          });
        });
      });
    }
    bindCopyButtons();
    document.addEventListener('astro:after-swap', bindCopyButtons);
  })();
</script>
