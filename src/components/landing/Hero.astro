---
import TerminalBlock from './TerminalBlock';
import RealAdminMockup from './RealAdminMockup';
import { useTranslations } from '../../i18n/ui';

interface Props {
  lang: 'ru' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative min-h-[calc(100vh-5rem)] flex items-center justify-center overflow-hidden py-8 sm:py-12 px-3 sm:px-4">
  
  <!-- Central Hero Content: 100% Centered, responsive typography, zero displacement -->
  <div class="relative z-10 max-w-4xl mx-auto text-center space-y-5 sm:space-y-6 w-full">
    <div class="space-y-3 sm:space-y-4">
      
      <!-- Slogan (Centered, clean, responsive font size) -->
      <h1 class="text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-tight break-words [overflow-wrap:anywhere]">
        <span class="inline sm:block hero-title-1">{t('hero.title.1')} </span>
        <span class="inline sm:block hero-title-2">{t('hero.title.2')} </span>
        <span class="inline sm:block hero-title-3">{t('hero.title.3')}</span>
      </h1>

      <!-- Short Subtitle -->
      <p class="hero-subtitle max-w-2xl mx-auto text-xs sm:text-base leading-relaxed px-1">
        {lang === 'ru'
          ? 'Событийно-ориентированный биллинг для VPN, SaaS, хостинга и ключей с изолированной Lua-логикой и Server-Driven UI.'
          : 'Event-driven billing engine for VPN, SaaS, hosting, and digital keys powered by isolated Lua and Server-Driven UI.'}
      </p>

      <!-- Terminal & Action Buttons (Centered) -->
      <div class="w-full max-w-xl mx-auto pt-2">
        <TerminalBlock 
          client:load 
          command="curl -fsSL https://get.saviorbill.com | bash" 
          copiedText={t('hero.copied')}
        />
      </div>

      <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-3 pt-1">
        <a 
          href={`/${lang}/docs/quickstart`} 
          class="h-9 px-4 sm:px-5 rounded-xl bg-[#009080] hover:bg-[#0c5e53] text-white text-xs sm:text-sm font-semibold inline-flex items-center justify-center transition-colors shadow-sm"
        >
          {t('hero.btn.docs')}
        </a>
        <a 
          href="https://github.com/UNVISLATE/SaviorBill" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hero-secondary-btn h-9 px-4 sm:px-5 rounded-xl bg-[oklch(0.22_0_0)] hover:bg-[oklch(0.26_0_0)] text-white text-xs sm:text-sm font-semibold inline-flex items-center justify-center gap-2 transition-all shadow-xs"
        >
          <svg class="size-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>{t('hero.btn.github')}</span>
        </a>
      </div>

    </div>
  </div>

  <!-- Background Interactive Real Admin Mockup (strictly >= 1536px) -->
  <div class="hero-mockup-wrapper hidden min-[1536px]:block absolute left-[calc(50%+490px)] 2xl:left-[calc(50%+520px)] bottom-0 w-[940px] 2xl:w-[1020px] h-[660px] 2xl:h-[700px] z-0 pointer-events-auto opacity-85 hover:opacity-100 transition-opacity duration-300">
    <RealAdminMockup client:load />
  </div>

</section>
