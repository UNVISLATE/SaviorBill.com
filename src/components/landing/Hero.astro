---
import TerminalBlock from './TerminalBlock';
import RealAdminMockup from './RealAdminMockup';
import { useTranslations } from '../../i18n/ui';

interface Props {
  lang: 'ru' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative min-h-[82vh] lg:min-h-[86vh] flex items-center overflow-hidden py-10 lg:py-16 px-3 sm:px-4">
  <div class="max-w-6xl mx-auto w-full relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Left Column: Hero Text & Quickstart (cols 1..7) -->
      <div class="lg:col-span-7 space-y-5 text-left hero-text-backdrop">
        <!-- Main Slogan -->
        <h1 class="text-3xl sm:text-4xl md:text-[2.65rem] font-bold tracking-tight text-white dark:text-white light:text-slate-900 leading-tight">
          <span>{t('hero.title.1')} </span>
          <span class="text-[oklch(0.72_0_0)] dark:text-[oklch(0.72_0_0)] light:text-slate-600">{t('hero.title.2')} </span>
          <br class="hidden sm:inline" />
          <span class="text-[#009080]">{t('hero.title.3')}</span>
        </h1>

        <!-- Short Subtitle -->
        <p class="max-w-xl text-xs sm:text-sm text-[oklch(0.65_0_0)] dark:text-[oklch(0.65_0_0)] light:text-slate-600 leading-relaxed">
          {lang === 'ru'
            ? 'Событийно-ориентированный биллинг для VPN, SaaS, хостинга и ключей с изолированной Lua-логикой и Server-Driven UI.'
            : 'Event-driven billing engine for VPN, SaaS, hosting, and digital keys powered by isolated Lua and Server-Driven UI.'}
        </p>

        <!-- Terminal & Action Buttons (Compact inline/stack) -->
        <div class="max-w-md pt-1">
          <TerminalBlock 
            client:load 
            command="curl -fsSL https://get.saviorbill.com | bash" 
            copiedText={t('hero.copied')}
          />
        </div>

        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a 
            href={`/${lang}/docs/quickstart`} 
            class="h-9 px-5 rounded-xl bg-[#009080] hover:bg-[#0c5e53] text-white text-xs sm:text-sm font-semibold inline-flex items-center justify-center transition-colors shadow-sm"
          >
            {t('hero.btn.docs')}
          </a>
          <a 
            href="https://github.com/UNVISLATE/SaviorBill" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="h-9 px-5 rounded-xl bg-[oklch(0.22_0_0)] hover:bg-[oklch(0.26_0_0)] text-white text-xs sm:text-sm font-semibold inline-flex items-center justify-center gap-2 transition-colors"
          >
            <svg class="size-4" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span>{t('hero.btn.github')}</span>
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- Right Floating Background Mockup (Cropped at right and bottom without affecting layout) -->
  <div class="hidden lg:block absolute left-[54%] top-1/2 -translate-y-1/2 w-[880px] xl:w-[980px] z-0 pointer-events-auto opacity-95 transition-opacity hover:opacity-100">
    <RealAdminMockup client:load />
  </div>
</section>
