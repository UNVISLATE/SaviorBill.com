---
import { useTranslations } from '../../i18n/ui';

interface Props {
  lang: 'ru' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="bg-[oklch(0.12_0_0)] text-[oklch(0.708_0_0)] text-sm py-16 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12">
      <!-- Col 1: Brand -->
      <div class="space-y-4 md:col-span-1">
        <div class="flex items-center gap-2 text-white font-bold text-lg">
          <div class="w-6 h-6 rounded bg-[#009080] flex items-center justify-center text-white text-xs font-mono">
            SB
          </div>
          <span>Savior<span class="text-[#009080]">Bill</span></span>
        </div>
        <p class="text-xs text-[oklch(0.55_0_0)] leading-relaxed">
          {lang === 'ru' 
            ? 'Событийно-ориентированная self-hosted платформа биллинга и движок магазина цифровых услуг с изолированной Lua-логикой.'
            : 'Event-driven self-hosted billing engine & digital storefront powered by isolated Lua runtime.'}
        </p>
      </div>

      <!-- Col 2: Docs -->
      <div>
        <h4 class="text-white text-xs font-semibold uppercase tracking-wider mb-4 font-mono">
          {t('nav.docs')}
        </h4>
        <ul class="space-y-2.5 text-xs">
          <li><a href={`/${lang}/docs/quickstart`} class="hover:text-white transition-colors">{lang === 'ru' ? 'Быстрый старт' : 'Quickstart'}</a></li>
          <li><a href={`/${lang}/docs/architecture`} class="hover:text-white transition-colors">{lang === 'ru' ? 'Архитектура' : 'Architecture'}</a></li>
          <li><a href={`/${lang}/docs/lua-contracts`} class="hover:text-white transition-colors">{lang === 'ru' ? 'Контракты Lua' : 'Lua Contracts'}</a></li>
          <li><a href={`/${lang}/docs/sbuisdk`} class="hover:text-white transition-colors">Server-Driven UI (sbuiSDK)</a></li>
        </ul>
      </div>

      <!-- Col 3: Ecosystem -->
      <div>
        <h4 class="text-white text-xs font-semibold uppercase tracking-wider mb-4 font-mono">
          {lang === 'ru' ? 'Экосистема' : 'Ecosystem'}
        </h4>
        <ul class="space-y-2.5 text-xs">
          <li><a href="https://github.com/UNVISLATE/SaviorBill" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">SaviorBill Core</a></li>
          <li><a href="https://github.com/UNVISLATE/SBPersonalAccountClient" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Personal Account Client</a></li>
          <li><a href="https://github.com/UNVISLATE/sbuiSDK" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">sbuiSDK Library</a></li>
          <li><a href={`/${lang}/hub`} class="hover:text-white transition-colors">{t('nav.hub')}</a></li>
        </ul>
      </div>

      <!-- Col 4: Links -->
      <div>
        <h4 class="text-white text-xs font-semibold uppercase tracking-wider mb-4 font-mono">
          {lang === 'ru' ? 'Сообщество' : 'Community'}
        </h4>
        <ul class="space-y-2.5 text-xs">
          <li><a href="https://habr.com/ru/articles/1109434/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Habr Article</a></li>
          <li><a href="https://t.me/unvi_xyz" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Telegram</a></li>
          <li><a href="https://unvi.xyz" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">unvi.xyz</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Credits -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[oklch(0.55_0_0)]">
      <div>
        © {year} SaviorBill · {t('footer.rights')}
      </div>
      <div>
        {t('footer.license')}
      </div>
    </div>
  </div>
</footer>
