---
---

<!-- Lunoweb 1:1 SVG Curved Morphing Curtain Transition with AppLike Logo -->
<div 
  id="lunoweb-curve-wrapper" 
  transition:persist="lunoweb-curve"
  class="fixed inset-0 pointer-events-none select-none overflow-hidden m-0 p-0 border-0"
  style="z-index: 2147483647; display: none;"
  aria-hidden="true"
>
  <!-- Curved Morphing SVG Background -->
  <svg 
    id="lunoweb-curve-svg" 
    class="pointer-events-none fixed top-0 left-0 w-screen"
    style="height: calc(100vh + 600px); z-index: 2147483646; will-change: transform;"
  >
    <path id="lunoweb-curve-path" style="will-change: d;" />
  </svg>

  <!-- Centered Route & AppLike Logo Label -->
  <div 
    id="lunoweb-curve-route" 
    class="fixed left-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col items-center gap-5 sm:gap-7 text-center pointer-events-none"
    style="top: 47.5%; opacity: 0; z-index: 2147483647; will-change: transform, opacity;"
  >
    <img 
      id="lunoweb-curve-logo"
      src="/images/logo-applike-white.svg" 
      alt="SaviorBill" 
      class="size-16 sm:size-20 md:size-24 object-contain drop-shadow-2xl" 
    />
    <span 
      id="lunoweb-curve-title" 
      class="text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-widest uppercase font-sans drop-shadow-md select-none"
    >
      БЛОГ
    </span>
  </div>
</div>

<script is:inline>
  (function() {
    const SECTION_NAMES = {
      ru: {
        home: 'ГЛАВНАЯ',
        blog: 'БЛОГ',
        docs: 'ДОКУМЕНТАЦИЯ',
        hub: 'LUA ХАБ'
      },
      en: {
        home: 'HOME',
        blog: 'BLOG',
        docs: 'DOCS',
        hub: 'LUA HUB'
      }
    };

    function getRootSection(input) {
      if (!input) return 'home';
      let pathname = '';
      if (typeof input === 'string') {
        pathname = input.startsWith('http') ? new URL(input).pathname : input.split('?')[0].split('#')[0];
      } else if (input && typeof input.pathname === 'string') {
        pathname = input.pathname;
      }
      
      const segments = pathname.replace(/^\/+/, '').replace(/\/+$/, '').split('/').filter(Boolean);
      if (segments.length > 0 && (segments[0] === 'en' || segments[0] === 'ru')) {
        segments.shift();
      }

      if (segments.length === 0) return 'home';
      const first = segments[0].toLowerCase();
      if (first === 'blog') return 'blog';
      if (first === 'docs') return 'docs';
      if (first === 'hub') return 'hub';
      return 'other';
    }

    // Exact cubic-bezier curve evaluator from Lunoweb
    function cubicBezier(p1x, p1y, p2x, p2y) {
      const cx = 3 * p1x;
      const bx = 3 * (p2x - p1x) - cx;
      const ax = 1 - cx - bx;

      const cy = 3 * p1y;
      const by = 3 * (p2y - p1y) - cy;
      const ay = 1 - cy - by;

      function sampleCurveX(t) {
        return ((ax * t + bx) * t + cx) * t;
      }
      function sampleCurveY(t) {
        return ((ay * t + by) * t + cy) * t;
      }
      function solveCurveX(x) {
        let t0 = x;
        for (let i = 0; i < 8; i++) {
          const x2 = sampleCurveX(t0) - x;
          if (Math.abs(x2) < 1e-4) return t0;
          const d2 = (3 * ax * t0 + 2 * bx) * t0 + cx;
          if (Math.abs(d2) < 1e-4) break;
          t0 -= x2 / d2;
        }
        return t0;
      }
      return function(x) {
        return sampleCurveY(solveCurveX(Math.max(0, Math.min(1, x))));
      };
    }

    // Lunoweb easing curves:
    // easeSlide: [0.76, 0, 0.24, 1]
    // easeText: [0.33, 1, 0.68, 1]
    const easeSlide = cubicBezier(0.76, 0, 0.24, 1);
    const easeText = cubicBezier(0.33, 1, 0.68, 1);

    // Exact Bezier SVG path formulas from Lunoweb:
    // p = 0: targetPath (flat bottom at height)
    // p = 1: initialPath (curved downward bottom to height + 600)
    function buildPath(width, height, p) {
      const bottomEdge = height + 300 * p;
      const controlY = height + 600 * p;
      return `M0 300 Q${width / 2} 0 ${width} 300 L${width} ${bottomEdge} Q${width / 2} ${controlY} 0 ${bottomEdge} L0 0`;
    }

    let isTransitionActive = false;
    let animFrame = null;

    // 1. Enter Phase: Triggered before page navigation swap
    document.addEventListener('astro:before-preparation', (event) => {
      const wrapper = document.getElementById('lunoweb-curve-wrapper');
      const svg = document.getElementById('lunoweb-curve-svg');
      const path = document.getElementById('lunoweb-curve-path');
      const route = document.getElementById('lunoweb-curve-route');
      const logoEl = document.getElementById('lunoweb-curve-logo');
      const titleEl = document.getElementById('lunoweb-curve-title');

      if (!wrapper || !svg || !path || !route || !titleEl || !logoEl) return;

      const fromPath = window.location.pathname;
      const toPath = event.to.pathname;

      const fromSec = getRootSection(fromPath);
      const toSec = getRootSection(toPath);
      const validRoots = ['home', 'blog', 'docs', 'hub'];

      // Only trigger curtain when changing ROOT section
      if (fromSec !== toSec && validRoots.includes(fromSec) && validRoots.includes(toSec)) {
        isTransitionActive = true;
        document.documentElement.setAttribute('data-curtain-active', 'true');

        const width = window.innerWidth;
        const height = window.innerHeight;

        // Theme colors:
        // Dark theme: pitch black #000000, white AppLike logo, white text
        // Light theme: pure white #ffffff, gray AppLike logo, dark text
        const isLight = document.documentElement.classList.contains('light');
        const curtainBg = isLight ? '#ffffff' : '#000000';
        const textColor = isLight ? '#1e293b' : '#ffffff';
        const logoSrc = isLight ? '/images/logo-applike-gray.svg' : '/images/logo-applike-white.svg';

        svg.style.fill = curtainBg;
        titleEl.style.color = textColor;
        logoEl.src = logoSrc;

        // Set destination title
        const lang = toPath.startsWith('/en') ? 'en' : 'ru';
        const sectionTitle = SECTION_NAMES[lang]?.[toSec] || toSec.toUpperCase();
        titleEl.textContent = sectionTitle;

        // Show wrapper
        wrapper.style.display = 'block';
        wrapper.style.pointerEvents = 'auto';

        // Initial positions (below viewport)
        svg.style.transform = `translate3d(0, ${height}px, 0)`;
        path.setAttribute('d', buildPath(width, height, 0));
        route.style.top = '47.5%';
        route.style.opacity = '0';

        const originalLoader = event.loader;
        event.loader = async () => {
          await new Promise((resolve) => {
            const duration = 460; // 0.46s Lunoweb curve duration
            const startTime = performance.now();

            function frame(now) {
              const elapsed = now - startTime;
              const progress = Math.min(1, elapsed / duration);

              // 1. SVG slide up from height to -300px
              const tSlide = easeSlide(progress);
              const currentY = height - (height + 300) * tSlide;
              svg.style.transform = `translate3d(0, ${currentY}px, 0)`;

              // 2. SVG path morph from 0 to 1
              path.setAttribute('d', buildPath(width, height, tSlide));

              // 3. Route text & logo: delay 160ms, duration 280ms, slide from 47.5% to 40% & fade in
              const textDelay = 160;
              const textDuration = 280;
              if (elapsed >= textDelay) {
                const textProgress = Math.min(1, (elapsed - textDelay) / textDuration);
                const tText = easeText(textProgress);
                const currentTop = 47.5 - 7.5 * tText;
                route.style.top = `${currentTop}%`;
                route.style.opacity = `${tText}`;
              }

              if (progress < 1) {
                animFrame = requestAnimationFrame(frame);
              } else {
                svg.style.transform = `translate3d(0, -300px, 0)`;
                path.setAttribute('d', buildPath(width, height, 1));
                route.style.top = '40%';
                route.style.opacity = '1';
                resolve();
              }
            }

            animFrame = requestAnimationFrame(frame);
          });

          // Allow Astro to swap DOM behind covered screen
          await originalLoader();
        };
      }
    });

    // 2. Exit Phase: Immediately after new DOM is swapped behind the curtain
    document.addEventListener('astro:after-swap', () => {
      if (!isTransitionActive) return;

      const wrapper = document.getElementById('lunoweb-curve-wrapper');
      const svg = document.getElementById('lunoweb-curve-svg');
      const path = document.getElementById('lunoweb-curve-path');
      const route = document.getElementById('lunoweb-curve-route');

      if (!wrapper || !svg || !path || !route) return;

      const width = window.innerWidth;
      const height = window.innerHeight;

      // Keep curtain solidly covering viewport during DOM insertion
      wrapper.style.display = 'block';
      svg.style.transform = `translate3d(0, -300px, 0)`;
      path.setAttribute('d', buildPath(width, height, 1));
      route.style.top = '40%';
      route.style.opacity = '1';

      // Start exit animation smoothly on next frame
      requestAnimationFrame(() => {
        const duration = 480; // 0.48s
        const startTime = performance.now();
        const startY = -300;
        const targetY = -(height + 600);

        function exitFrame(now) {
          const elapsed = now - startTime;
          const progress = Math.min(1, elapsed / duration);
          const tSlide = easeSlide(progress);

          // 1. SVG slide up from -300px to targetY
          const currentY = startY + (targetY - startY) * tSlide;
          svg.style.transform = `translate3d(0, ${currentY}px, 0)`;

          // 2. SVG path morph from 1 back to 0
          path.setAttribute('d', buildPath(width, height, 1 - tSlide));

          // 3. Route text & logo: slide up to -120px and fade out
          const textTop = 40 - 65 * tSlide;
          route.style.top = `${textTop}%`;
          route.style.opacity = `${Math.max(0, 1 - tSlide * 1.5)}`;

          if (progress < 1) {
            animFrame = requestAnimationFrame(exitFrame);
          } else {
            // Clean up when animation finishes
            wrapper.style.display = 'none';
            wrapper.style.pointerEvents = 'none';
            document.documentElement.removeAttribute('data-curtain-active');
            isTransitionActive = false;
          }
        }

        animFrame = requestAnimationFrame(exitFrame);
      });
    });
  })();
</script>
