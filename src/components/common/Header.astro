---
import { useTranslations } from '../../i18n/ui';

interface Props {
  lang: 'ru' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;
const cleanPath = currentPath.replace(/^\/(ru|en)/, '') || '/';

const targetLang = lang === 'ru' ? 'en' : 'ru';
const switchLangUrl = `/${targetLang}${cleanPath === '/' ? '' : cleanPath}`;
---

<header class="sticky top-3 z-50 px-3 sm:px-4">
  <div class="relative mx-auto max-w-6xl">
    <div class="flex items-center justify-between gap-4 rounded-2xl border border-[oklch(1_0_0/8%)] bg-[oklch(0.145_0_0/85%)] px-4 py-2.5 sm:px-5 shadow-lg shadow-black/20 backdrop-blur-md">
      <!-- Logo -->
      <a href={`/${lang}`} class="inline-flex items-center gap-2.5 font-bold tracking-tight text-white hover:opacity-90 transition-opacity">
        <img 
          src="/logo.svg" 
          alt="SaviorBill" 
          class="size-8 object-contain"
        />
        <span class="text-base sm:text-lg">Savior<span class="text-[#009080]">Bill</span></span>
      </a>

      <!-- Navigation Links -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-[oklch(0.708_0_0)]">
        <a href={`/${lang}/docs/quickstart`} class="hover:text-white transition-colors py-1">
          {t('nav.docs')}
        </a>
        <a href={`/${lang}/blog`} class="hover:text-white transition-colors py-1">
          {t('nav.blog')}
        </a>
        <a href={`/${lang}/hub`} class="hover:text-white transition-colors py-1">
          {t('nav.hub')}
        </a>
        <a 
          href="https://github.com/UNVISLATE/SaviorBill" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-white transition-colors flex items-center gap-1"
        >
          <span>{t('nav.github')}</span>
          <svg class="size-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </nav>

      <!-- Actions -->
      <div class="flex items-center gap-3">
        <!-- Language Switcher -->
        <a 
          href={switchLangUrl} 
          class="px-2.5 py-1 text-xs font-mono font-semibold rounded-lg bg-[oklch(0.22_0_0)] hover:bg-[oklch(0.26_0_0)] text-white transition-colors border border-[oklch(1_0_0/6%)]"
          title="Switch language"
        >
          {targetLang.toUpperCase()}
        </a>

        <!-- Quickstart Button -->
        <a 
          href={`/${lang}/docs/quickstart`} 
          class="inline-flex items-center justify-center px-3.5 py-1.5 text-xs font-semibold rounded-xl bg-[#009080] hover:bg-[#0c5e53] text-white transition-all shadow-sm"
        >
          {lang === 'ru' ? 'Быстрый старт' : 'Quickstart'}
        </a>
      </div>
    </div>
  </div>
</header>
