---
interface Props {
  title: string;
  description: string;
  lang?: 'ru' | 'en';
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title,
  description,
  lang = 'ru',
  canonical,
  image = 'https://saviorbill.com/og-image.png',
  type = 'website',
  jsonLd
} = Astro.props;

const siteUrl = 'https://saviorbill.com';
const currentPath = Astro.url.pathname;
const cleanPath = currentPath.replace(/^\/(ru|en)(\/|$)/, '/').replace(/\/+$/, '') || '/';
const canonicalUrl = canonical || `${siteUrl}${currentPath}`;
const ruUrl = `${siteUrl}${cleanPath === '/' ? '' : cleanPath}`;
const enUrl = `${siteUrl}/en${cleanPath === '/' ? '' : cleanPath}`;

// Ensure image is always a full absolute HTTPS URL (MANDATORY for Telegram, Twitter, Discord)
const ogImageUrl = image.startsWith('http') 
  ? image 
  : `${siteUrl}${image.startsWith('/') ? image : `/${image}`}`;
---

<!-- Primary Meta Tags -->
<title>{title} | SaviorBill</title>
<meta name="title" content={`${title} | SaviorBill`} />
<meta name="description" content={description} />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="canonical" href={canonicalUrl} />

<!-- Alternate Languages -->
<link rel="alternate" hreflang="ru" href={ruUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={ruUrl} />

<!-- RSS Feeds -->
<link rel="alternate" type="application/rss+xml" title={lang === 'ru' ? 'SaviorBill Блог (RSS)' : 'SaviorBill Blog (RSS)'} href={`${siteUrl}${lang === 'ru' ? '/rss.xml' : '/en/rss.xml'}`} />

<!-- Agentic Resource Discovery / WebMCP -->
<link rel="ai-catalog" href="/.well-known/ai-catalog.json" />

<!-- Open Graph / Telegram / Facebook -->
<meta property="og:site_name" content="SaviorBill" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={`${title} | SaviorBill`} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:secure_url" content={ogImageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={`${title} | SaviorBill`} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={title} />

<!-- Schema.org JSON-LD -->
{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}
