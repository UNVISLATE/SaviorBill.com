---

<div class="ambient-background-container pointer-events-none fixed inset-0 -z-20 overflow-hidden" aria-hidden="true">
  <!-- Subtle dynamic gradient mesh nodes with gentle, slow CSS hardware-accelerated movement -->
  <div class="ambient-mesh-node ambient-node-1"></div>
  <div class="ambient-mesh-node ambient-node-2"></div>
  <div class="ambient-mesh-node ambient-node-3"></div>
</div>

<style>
  .ambient-background-container {
    opacity: 0.5;
    transition: opacity 0.6s ease;
  }

  html.light .ambient-background-container {
    opacity: 0.35;
  }

  .ambient-mesh-node {
    position: absolute;
    border-radius: 9999px;
    filter: blur(90px);
    will-change: transform;
    pointer-events: none;
  }

  /* Deep teal/emerald ambient drift */
  .ambient-node-1 {
    top: -10%;
    left: 20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(0, 144, 128, 0.22) 0%, rgba(0, 144, 128, 0) 70%);
    animation: drift-slow-1 28s infinite alternate ease-in-out;
  }

  html.light .ambient-node-1 {
    background: radial-gradient(circle, rgba(0, 144, 128, 0.18) 0%, rgba(0, 144, 128, 0) 70%);
  }

  /* Cool slate/indigo drift */
  .ambient-node-2 {
    top: 35%;
    right: 5%;
    width: 550px;
    height: 550px;
    background: radial-gradient(circle, rgba(30, 41, 59, 0.3) 0%, rgba(30, 41, 59, 0) 70%);
    animation: drift-slow-2 34s infinite alternate ease-in-out;
  }

  html.light .ambient-node-2 {
    background: radial-gradient(circle, rgba(148, 163, 184, 0.25) 0%, rgba(148, 163, 184, 0) 70%);
  }

  /* Lower subtle teal drift */
  .ambient-node-3 {
    bottom: 5%;
    left: 10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(12, 94, 83, 0.18) 0%, rgba(12, 94, 83, 0) 70%);
    animation: drift-slow-3 32s infinite alternate ease-in-out;
  }

  html.light .ambient-node-3 {
    background: radial-gradient(circle, rgba(0, 144, 128, 0.12) 0%, rgba(0, 144, 128, 0) 70%);
  }

  @keyframes drift-slow-1 {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(80px, 40px, 0) scale(1.08);
    }
    100% {
      transform: translate3d(-50px, 70px, 0) scale(0.95);
    }
  }

  @keyframes drift-slow-2 {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(-70px, -50px, 0) scale(1.05);
    }
    100% {
      transform: translate3d(40px, 30px, 0) scale(0.92);
    }
  }

  @keyframes drift-slow-3 {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(50px, -40px, 0) scale(1.1);
    }
    100% {
      transform: translate3d(-40px, 20px, 0) scale(0.96);
    }
  }
</style>
