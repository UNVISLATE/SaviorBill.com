{
  "slug": "marzban-vless",
  "id": "marzban-vless",
  "name": "Marzban VLESS VPN Delivery",
  "category": "VPN & Proxies",
  "author": "Andrey UNVI",
  "version": "0.9.8-beta",
  "status": "not-stable",
  "description": "Автоматическая выдача и продление VLESS-подписок через REST API панели Marzban. Создание пользователя, продление срока действия, заморозка и отзыв доступа.",
  "actions": ["create", "renew", "stop", "delete", "freeze"],
  "settings_form": [
    {
      "id": "mock_mode",
      "type": "checkbox",
      "label": "Режим демонстрации (Mock / Sandbox)",
      "default": false,
      "description": "Эмуляция работы Marzban без подключения к реальной панели (для демостендов и тестирования)"
    },
    {
      "id": "marzban_domain",
      "type": "text",
      "label": "Домен панели Marzban",
      "placeholder": "panel.example.com",
      "required": false,
      "description": "Домен панели без протокола https:// (или 'mock' для демонстрации)"
    },
    {
      "id": "marzban_user",
      "type": "text",
      "label": "Логин администратора",
      "placeholder": "admin",
      "required": false
    },
    {
      "id": "marzban_pass",
      "type": "password",
      "label": "Пароль администратора",
      "required": false
    },
    {
      "id": "data_limit_gb",
      "type": "number",
      "label": "Лимит трафика (ГБ)",
      "default": 0,
      "description": "0 — безлимитный трафик"
    },
    {
      "id": "reset_strategy",
      "type": "select",
      "label": "Стратегия сброса трафика",
      "default": "no_reset",
      "options": [
        { "value": "no_reset", "label": "Без сброса" },
        { "value": "month", "label": "Ежемесячно" },
        { "value": "year", "label": "Ежегодно" }
      ]
    }
  ],
  "view_trigger_label": "Инструкция и QR-код",
  "view_layout": {
    "type": "card",
    "variant": "elevated",
    "header": "Подключение VLESS (Xray / Reality)",
    "content": "Подключение VLESS (Xray / Reality)",
    "children": [
      {
        "type": "row",
        "align": "center",
        "justify": "between",
        "children": [
          { "type": "text", "variant": "caption", "content": "VLESS • Reality • TCP Vision" },
          { "type": "badge", "variant": "success", "content": "Активен" }
        ]
      },
      {
        "type": "column",
        "gap": 16,
        "align": "center",
        "children": [
          {
            "type": "qr",
            "value": "{{public.subscription_url}}",
            "size": 180,
            "plateRadius": 18,
            "qrStyle": "liquid",
            "logo": "UNVIDark"
          },
          {
            "type": "copy_field",
            "label": "Ссылка на подписку",
            "value": "{{public.subscription_url}}"
          }
        ]
      }
    ]
  }
}
