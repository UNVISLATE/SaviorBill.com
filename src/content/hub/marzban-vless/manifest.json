{
  "slug": "marzban-vless",
  "id": "marzban-vless",
  "name": "Marzban VLESS VPN Delivery",
  "category": "VPN & Proxies",
  "author": "Andrey UNVI",
  "version": "0.9.8-beta",
  "status": "not-stable",
  "description": "Автоматическая выдача и продление VLESS-подписок через REST API панели Marzban. Создание пользователя, продление срока действия, заморозка и отзыв доступа.",
  "actions": ["create", "renew", "stop", "delete", "freeze"],
  "settings_form": [
    {
      "id": "marzban_domain",
      "type": "text",
      "label": "Домен панели Marzban",
      "placeholder": "panel.example.com",
      "required": true,
      "description": "Домен панели без протокола https://"
    },
    {
      "id": "marzban_user",
      "type": "text",
      "label": "Логин администратора",
      "placeholder": "admin",
      "required": true
    },
    {
      "id": "marzban_pass",
      "type": "password",
      "label": "Пароль администратора",
      "required": true
    },
    {
      "id": "data_limit_gb",
      "type": "number",
      "label": "Лимит трафика (ГБ)",
      "default": 0,
      "description": "0 — безлимитный трафик"
    },
    {
      "id": "reset_strategy",
      "type": "select",
      "label": "Стратегия сброса трафика",
      "default": "no_reset",
      "options": [
        { "value": "no_reset", "label": "Без сброса" },
        { "value": "month", "label": "Ежемесячно" },
        { "value": "year", "label": "Ежегодно" }
      ]
    }
  ],
  "view_trigger_label": "Инструкция и QR-код",
  "view_layout": {
    "type": "card",
    "variant": "elevated",
    "content": "Подключение VLESS (Xray / Reality)",
    "children": [
      {
        "type": "row",
        "align": "center",
        "children": [
          { "type": "text", "variant": "caption", "content": "VLESS • Reality • TCP Vision" },
          { "type": "badge", "variant": "success", "content": "Активен" }
        ]
      },
      {
        "type": "row",
        "gap": 16,
        "align": "center",
        "children": [
          {
            "type": "qr",
            "props": {
              "value": "{{public.subscription_url}}",
              "size": 130,
              "plateRadius": 18,
              "qrStyle": "liquid",
              "logo": "UNVIDark"
            }
          },
          {
            "type": "column",
            "gap": 8,
            "children": [
              { "type": "text", "variant": "caption", "content": "Ссылка на подписку:" },
              {
                "type": "copy_field",
                "props": {
                  "value": "{{public.subscription_url}}",
                  "label": "Скопировать ссылку"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
