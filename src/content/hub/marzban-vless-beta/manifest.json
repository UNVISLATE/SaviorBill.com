{
  "slug": "marzban-vless-beta",
  "id": "marzban-vless-beta",
  "name": "Marzban (Only VLESS) | Beta",
  "category": "VPN",
  "author": "Andrey UNVI",
  "version": "0.0.2-beta",
  "status": "not-stable",
  "description": "Автоматическая выдача и продление VLESS-подписок через REST API панели Marzban.",
  "actions": ["create", "renew", "stop", "delete", "freeze"],
  "settings_form": [
    {
      "id": "mock_mode",
      "type": "toggle",
      "label": "Режим демонстрации (Mock / Sandbox)",
      "default": false,
      "description": "Эмуляция работы Marzban без подключения к реальной панели (для демостендов и тестирования)"
    },
    {
      "id": "marzban_domain",
      "type": "text",
      "label": "Домен панели Marzban",
      "placeholder": "panel.example.com",
      "required": false,
      "description": "Домен панели без протокола https:// (или 'mock' для демонстрации)"
    },
    {
      "id": "marzban_user",
      "type": "text",
      "label": "Логин администратора",
      "placeholder": "admin",
      "required": false
    },
    {
      "id": "marzban_pass",
      "type": "password",
      "label": "Пароль администратора",
      "required": false
    },
    {
      "id": "data_limit_gb",
      "type": "number",
      "label": "Лимит трафика (ГБ)",
      "default": 0,
      "description": "0 — безлимитный трафик"
    },
    {
      "id": "reset_strategy",
      "type": "select",
      "label": "Стратегия сброса трафика",
      "default": "no_reset",
      "options": [
        { "value": "no_reset", "label": "Без сброса" },
        { "value": "month", "label": "Ежемесячно" },
        { "value": "year", "label": "Ежегодно" }
      ]
    }
  ],
  "view_trigger_label": "Subscription",
  "view_layout": {
    "type": "card",
    "variant": "elevated",
    "header": "Subscription",
    "content": "Subscription URL",
    "children": [
      {
        "type": "column",
        "gap": 16,
        "align": "center",
        "children": [
          {
            "type": "qr",
            "value": "{{public.subscription_url}}",
            "size": 180,
            "plateRadius": 18,
            "qrStyle": "liquid",
            "logo": "UNVIDark"
          },
          {
            "type": "copy_field",
            "label": "Subscription URL",
            "value": "{{public.subscription_url}}"
          }
        ]
      }
    ]
  }
}
