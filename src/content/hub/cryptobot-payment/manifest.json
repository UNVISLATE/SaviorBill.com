{
  "slug": "cryptobot-payment",
  "id": "cryptobot-payment",
  "name": "CryptoBot (CryptoPay)",
  "category": "Payments",
  "author": "Andrey UNVI",
  "version": "1.0.0",
  "description": "Прием криптоплатежей через Telegram CryptoBot (CryptoPay API)",
  "actions": ["create", "callback", "check"],
  "settings_form": [
    {
      "id": "api_token",
      "type": "password",
      "label": "API Token CryptoBot",
      "placeholder": "12345:AA...",
      "required": true,
      "description": "Токен приложения, полученный в @CryptoBot (/pay → Create App)"
    },
    {
      "id": "network",
      "type": "select",
      "label": "Сеть (Network)",
      "default": "mainnet",
      "options": [
        { "value": "mainnet", "label": "Mainnet (@CryptoBot)" },
        { "value": "testnet", "label": "Testnet (@CryptoTestnetBot)" }
      ]
    },
    {
      "id": "currency_type",
      "type": "select",
      "label": "Тип базовой валюты",
      "default": "fiat",
      "options": [
        { "value": "fiat", "label": "Фиат (RUB, USD, EUR) с конвертацией в крипту" },
        { "value": "crypto", "label": "Криптовалюта напрямую (USDT, TON)" }
      ]
    },
    {
      "id": "accepted_assets",
      "type": "text",
      "label": "Разрешенные криптовалюты",
      "default": "USDT,TON,BTC,ETH,LTC,TRX",
      "description": "Список тикеров через запятую"
    }
  ]
}
