---
import RepoReleasesView from '../../views/RepoReleasesView.astro';
import repositories from '../../data/repositories.json';

export function getStaticPaths() {
  return repositories.map((r) => ({
    params: { repo: r.id }
  }));
}

const { repo } = Astro.params as { repo: string };
---

<RepoReleasesView lang="ru" repoId={repo} />
