---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="404 — Страница не найдена" 
  description="Запрашиваемая страница не существует или была перемещена."
  lang="ru"
>
  <div class="min-h-[calc(100vh-14rem)] flex items-center justify-center px-4 py-12 select-none">
    <div class="max-w-md w-full mx-auto text-center flex flex-col items-center">
      
      <!-- Mascot Container with Ambient Glow -->
      <div class="relative mb-6">
        <div 
          class="absolute -inset-6 rounded-full bg-[#009080]/20 blur-3xl pointer-events-none animate-pulse" 
          aria-hidden="true"
        ></div>
        <img 
          src="/unvi/mascot/NotFoundMascotUNVI.webp" 
          alt="SaviorBill 404 Mascot" 
          class="relative size-56 sm:size-64 object-contain drop-shadow-2xl transition-transform hover:scale-105 duration-300 pointer-events-auto"
        />
      </div>

      <!-- Text Section -->
      <div class="space-y-3 mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[oklch(0.24_0_0)] border border-[oklch(1_0_0/8%)] text-xs font-mono font-semibold text-[#009080]">
          <span class="size-1.5 rounded-full bg-[#009080] animate-ping"></span>
          <span id="error-badge">Ошибка 404</span>
        </div>

        <h1 id="error-title" class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Страница не найдена
        </h1>

        <p id="error-desc" class="text-xs sm:text-sm text-[oklch(0.65_0_0)] max-w-sm mx-auto leading-relaxed">
          Запрашиваемый раздел SaviorBill перемещён, удалён или никогда не существовал.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3">
        <button 
          type="button"
          onclick="window.history.back()"
          class="h-9 px-4 rounded-xl bg-[oklch(0.22_0_0)] hover:bg-[oklch(0.26_0_0)] text-white text-xs font-semibold inline-flex items-center justify-center gap-2 transition-all cursor-pointer shadow-xs active:scale-95"
        >
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span id="btn-back">Назад</span>
        </button>

        <a 
          id="btn-home"
          href="/ru"
          class="h-9 px-5 rounded-xl bg-[#009080] hover:bg-[#0c5e53] text-white text-xs font-semibold inline-flex items-center justify-center gap-2 transition-colors shadow-sm active:scale-95"
        >
          <svg class="size-4" fill="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span id="btn-home-text">На главную</span>
        </a>
      </div>

    </div>
  </div>

  <script is:inline>
    (function() {
      function adaptLang() {
        const path = window.location.pathname;
        const isEn = path.startsWith('/en');
        if (isEn) {
          const badge = document.getElementById('error-badge');
          const title = document.getElementById('error-title');
          const desc = document.getElementById('error-desc');
          const btnBack = document.getElementById('btn-back');
          const btnHome = document.getElementById('btn-home');
          const btnHomeText = document.getElementById('btn-home-text');
          
          if (badge) badge.textContent = 'Error 404';
          if (title) title.textContent = 'Page Not Found';
          if (desc) desc.textContent = 'The requested SaviorBill page has been moved, deleted, or never existed.';
          if (btnBack) btnBack.textContent = 'Go Back';
          if (btnHome) btnHome.setAttribute('href', '/en');
          if (btnHomeText) btnHomeText.textContent = 'Home Page';
        }
      }
      adaptLang();
      document.addEventListener('astro:after-swap', adaptLang);
    })();
  </script>
</BaseLayout>
