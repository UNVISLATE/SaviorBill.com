---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'ru' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params as { lang: 'ru' | 'en' };

const allPosts = await getCollection('blog');
const langPosts = allPosts
  .filter((post) => post.id.startsWith(`${lang}/`))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const title = lang === 'ru' ? 'Блог и статьи' : 'Blog & Engineering Notes';
const description = lang === 'ru'
  ? 'Инженерные разборы, архитектура биллинга, гайды по интеграции и новости платформы SaviorBill.'
  : 'Engineering deep-dives, billing architecture, integration guides, and platform updates.';

const featuredPost = langPosts[0];
const remainingPosts = langPosts.slice(1);
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Aligned strictly to max-w-6xl like Header -->
  <div class="px-3 sm:px-4 py-12 sm:py-16">
    <div class="max-w-6xl mx-auto space-y-10">
      
      <!-- Top Title Group -->
      <div class="text-center max-w-2xl mx-auto">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-3 blog-index-title">
          {title}
        </h1>
        <p class="text-sm sm:text-base blog-index-desc">
          {description}
        </p>
      </div>

      {featuredPost && (() => {
        const parts = featuredPost.id.split('/');
        const slug = parts.slice(1).join('/').replace(/\.(md|mdx)$/, '');
        const dateStr = typeof featuredPost.data.date === 'string' ? featuredPost.data.date : featuredPost.data.date.toISOString().split('T')[0];
        const coverImg = featuredPost.data.cover || `/images/og/${lang}-${slug}.svg`;
        const author = featuredPost.data.author || 'UNVI';

        return (
          <!-- Featured Wide Card (Arayas style data-variant="wide") -->
          <a
            href={`/${lang}/blog/${slug}`}
            class="group card-interactive p-5 sm:p-7 block rounded-2xl transition-all duration-300"
          >
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
              <!-- Left Cover (cols 1..6) -->
              <div class="md:col-span-6 aspect-video w-full rounded-xl overflow-hidden bg-[oklch(0.14_0_0)] relative">
                <img
                  src={coverImg}
                  alt={featuredPost.data.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="eager"
                />
              </div>

              <!-- Right Content (cols 7..12) -->
              <div class="md:col-span-6 space-y-3 flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-2 mb-2.5">
                    <span class="text-xs font-mono font-bold text-[#00e0cb] bg-[#009080]/15 px-2.5 py-1 rounded-md">
                      #{featuredPost.data.tags[0] || 'Featured'}
                    </span>
                    <span class="text-xs text-[oklch(0.55_0_0)] font-mono">• Главный материал</span>
                  </div>

                  <h2 class="text-xl sm:text-2xl font-bold blog-card-title group-hover:text-[#009080] transition-colors leading-snug mb-3">
                    {featuredPost.data.title}
                  </h2>

                  <p class="text-xs sm:text-sm blog-card-desc leading-relaxed line-clamp-3">
                    {featuredPost.data.description}
                  </p>
                </div>

                <div class="pt-4 border-t border-[oklch(1_0_0/6%)] blog-card-footer flex items-center justify-between text-xs font-mono text-[oklch(0.6_0_0)]">
                  <div class="flex items-center gap-2">
                    <span class="size-6 rounded-full bg-[#009080] text-white flex items-center justify-center font-bold text-[10px]">
                      {author[0]}
                    </span>
                    <span class="font-medium blog-card-author">{author}</span>
                    <span>•</span>
                    <time datetime={dateStr}>{dateStr}</time>
                  </div>
                  <span class="text-[#009080] font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                    {lang === 'ru' ? 'Читать' : 'Read'} →
                  </span>
                </div>
              </div>
            </div>
          </a>
        );
      })()}

      <!-- Remaining Posts Grid -->
      {remainingPosts.length > 0 && (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-2">
          {remainingPosts.map((post) => {
            const parts = post.id.split('/');
            const slug = parts.slice(1).join('/').replace(/\.(md|mdx)$/, '');
            const dateStr = typeof post.data.date === 'string' ? post.data.date : post.data.date.toISOString().split('T')[0];
            const coverImg = post.data.cover || `/images/og/${lang}-${slug}.svg`;
            const author = post.data.author || 'UNVI';

            return (
              <a
                href={`/${lang}/blog/${slug}`}
                class="group card-interactive p-5 flex flex-col justify-between rounded-xl"
              >
                <div>
                  <!-- Cover Image (16:9) with zoom on hover -->
                  <div class="aspect-video w-full rounded-xl overflow-hidden bg-[oklch(0.14_0_0)] relative mb-4">
                    <img
                      src={coverImg}
                      alt={post.data.title}
                      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                      loading="lazy"
                    />
                  </div>

                  <!-- Meta bar -->
                  <div class="flex items-center justify-between text-xs font-mono text-[oklch(0.55_0_0)] mb-2.5">
                    <div class="flex items-center gap-2">
                      <span class="text-white dark:text-white light:text-slate-900 font-medium">{author}</span>
                      <span>•</span>
                      <time datetime={dateStr}>{dateStr}</time>
                    </div>
                    {post.data.tags.length > 0 && (
                      <span class="badge-pill text-[11px] font-mono font-semibold px-2 py-0.5 rounded">
                        #{post.data.tags[0]}
                      </span>
                    )}
                  </div>

                  <!-- Title -->
                  <h3 class="text-base sm:text-lg font-bold blog-card-title group-hover:text-[#009080] transition-colors mb-2 line-clamp-2 leading-snug">
                    {post.data.title}
                  </h3>

                  <!-- Description -->
                  <p class="text-xs sm:text-sm blog-card-desc leading-relaxed line-clamp-3 mb-4">
                    {post.data.description}
                  </p>
                </div>

                <div class="pt-2 border-t border-[oklch(1_0_0/5%)] flex items-center justify-between text-xs font-medium text-[#009080]">
                  <span>{lang === 'ru' ? 'Читать статью' : 'Read article'}</span>
                  <span class="transition-transform group-hover:translate-x-1">→</span>
                </div>
              </a>
            );
          })}
        </div>
      )}

    </div>
  </div>
</BaseLayout>
