---
import fs from 'node:fs';
import path from 'node:path';
import HubDetailView from '../../../views/HubDetailView.astro';
import communityScripts from '../../../data/community-scripts.json';

export function getStaticPaths() {
  const languages: ('en')[] = ['en'];
  const hubDir = path.resolve('src/content/hub');
  const officialSlugs: string[] = [];

  if (fs.existsSync(hubDir)) {
    const dirs = fs.readdirSync(hubDir, { withFileTypes: true });
    for (const d of dirs) {
      if (d.isDirectory()) {
        officialSlugs.push(d.name);
      }
    }
  }

  const paths: { params: { lang: 'en'; slug: string } }[] = [];

  for (const lang of languages) {
    for (const slug of officialSlugs) {
      paths.push({ params: { lang, slug } });
    }
    for (const comm of communityScripts) {
      paths.push({ params: { lang, slug: comm.id } });
    }
  }

  return paths;
}

const { lang, slug } = Astro.params as { lang: 'ru' | 'en'; slug: string };
---

<HubDetailView lang={lang} slug={slug} />
