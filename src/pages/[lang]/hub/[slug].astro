---
import fs from 'node:fs';
import path from 'node:path';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleQuoteAndAnchors from '../../../components/common/ArticleQuoteAndAnchors.astro';
import MediaLightbox from '../../../components/blog/MediaLightbox';
import communityScripts from '../../../data/community-scripts.json';

export function getStaticPaths() {
  const languages: ('ru' | 'en')[] = ['ru', 'en'];
  const hubDir = path.resolve('src/content/hub');
  const officialSlugs: string[] = [];

  if (fs.existsSync(hubDir)) {
    const dirs = fs.readdirSync(hubDir, { withFileTypes: true });
    for (const d of dirs) {
      if (d.isDirectory()) {
        officialSlugs.push(d.name);
      }
    }
  }

  const paths: { params: { lang: 'ru' | 'en'; slug: string } }[] = [];

  for (const lang of languages) {
    for (const slug of officialSlugs) {
      paths.push({ params: { lang, slug } });
    }
    for (const comm of communityScripts) {
      paths.push({ params: { lang, slug: comm.id } });
    }
  }

  return paths;
}

const { lang, slug } = Astro.params as { lang: 'ru' | 'en'; slug: string };

let manifest: any = null;
let readmeContent = '';
let readmeHtml = '';
let isOfficial = true;
let repoUrl = 'https://github.com/UNVISLATE/SaviorBill';
let downloadUrl = `/downloads/hub/${slug}.zip`;
let sourceFiles: string[] = [];

// Check if official
const scriptDir = path.resolve(`src/content/hub/${slug}`);
if (fs.existsSync(scriptDir)) {
  const mPath = path.join(scriptDir, 'manifest.json');
  if (fs.existsSync(mPath)) {
    try {
      manifest = JSON.parse(fs.readFileSync(mPath, 'utf-8'));
    } catch (e) {}
  }

  const allFiles = fs.readdirSync(scriptDir);
  sourceFiles = allFiles.filter(
    (f) => !f.toLowerCase().startsWith('readme') && !f.startsWith('.') && !f.endsWith('.zip')
  );

  // Sort so .lua comes first, then manifest.json, then others
  sourceFiles.sort((a, b) => {
    if (a.endsWith('.lua') && !b.endsWith('.lua')) return -1;
    if (!a.endsWith('.lua') && b.endsWith('.lua')) return 1;
    if (a === 'manifest.json') return -1;
    if (b === 'manifest.json') return 1;
    return a.localeCompare(b);
  });

  const readmeFile = allFiles.find((f) => f.toLowerCase().startsWith('readme'));
  if (readmeFile) {
    readmeContent = fs.readFileSync(path.join(scriptDir, readmeFile), 'utf-8');
    const processor = await createMarkdownProcessor();
    const rendered = await processor.render(readmeContent);
    readmeHtml = rendered.code;
  }
} else {
  // Check community scripts
  const comm = communityScripts.find((c) => c.id === slug);
  if (comm) {
    isOfficial = false;
    manifest = comm;
    repoUrl = comm.repo;
    downloadUrl = comm.downloadUrl;
  }
}

if (!manifest) {
  manifest = {
    id: slug,
    name: slug,
    category: 'Custom',
    version: '1.0.0',
    description: 'SaviorBill Lua Module'
  };
}

const pageTitle = `${manifest.name} — SaviorBill Lua Hub`;
const pageDescription = manifest.description;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  'name': manifest.name,
  'programmingLanguage': 'Lua',
  'codeRepository': repoUrl,
  'description': manifest.description,
  'downloadUrl': downloadUrl.startsWith('http') ? downloadUrl : `https://saviorbill.com${downloadUrl}`
};
---

<BaseLayout title={pageTitle} description={pageDescription} lang={lang} jsonLd={jsonLd}>
  <div class="px-3 sm:px-4 py-12 sm:py-16">
    <div class="max-w-4xl mx-auto space-y-8">
      
      <!-- Breadcrumbs -->
      <div class="flex items-center gap-2 text-xs font-mono text-[oklch(0.55_0_0)]">
        <a href={`/${lang}`} class="hover:text-[#009080] transition-colors">SaviorBill</a>
        <span>/</span>
        <a href={`/${lang}/hub`} class="hover:text-[#009080] transition-colors">
          {lang === 'ru' ? 'Каталог Lua' : 'Lua Hub'}
        </a>
        <span>/</span>
        <span class="text-[#009080]">{manifest.name}</span>
      </div>

      <!-- Script Header Card -->
      <div class="card-surface p-6 sm:p-8 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="space-y-2">
            <div class="flex flex-wrap items-center gap-2">
              <span class="badge-pill px-2.5 py-0.5 rounded text-xs font-mono font-semibold">
                {manifest.category}
              </span>
              <span class="text-xs font-mono text-[oklch(0.55_0_0)]">v{manifest.version}</span>
              {isOfficial ? (
                <span class="px-2 py-0.5 rounded-full bg-[#009080]/15 text-[#009080] font-mono text-xs font-semibold">
                  ✓ Verified Official
                </span>
              ) : (
                <span class="px-2 py-0.5 rounded-full bg-slate-500/15 text-slate-300 font-mono text-xs font-semibold">
                  Community by @{manifest.author}
                </span>
              )}
            </div>

            <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
              {manifest.name}
            </h1>
          </div>

          <!-- Download Action Button -->
          <div class="flex items-center gap-3 shrink-0">
            <a
              href={downloadUrl}
              download
              class="h-10 px-5 rounded-xl bg-[#009080] hover:bg-[#0c5e53] text-white text-xs sm:text-sm font-semibold inline-flex items-center gap-2 transition-colors shadow-sm"
            >
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span>{lang === 'ru' ? 'Скачать .zip' : 'Download .zip'}</span>
            </a>

            {repoUrl && (
              <a
                href={repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="size-10 rounded-xl bg-[oklch(0.22_0_0)] hover:bg-[oklch(0.26_0_0)] text-white flex items-center justify-center transition-colors shadow-xs"
                title="GitHub Repository"
              >
                <svg class="size-4" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                </svg>
              </a>
            )}
          </div>
        </div>

        <p class="text-sm sm:text-base text-[oklch(0.7_0_0)] leading-relaxed">
          {manifest.description}
        </p>

        <!-- Actions Badges -->
        {manifest.actions && manifest.actions.length > 0 && (
          <div class="pt-4 border-t border-[oklch(1_0_0/6%)] flex flex-wrap items-center gap-2">
            <span class="text-xs font-mono text-[oklch(0.55_0_0)]">
              {lang === 'ru' ? 'Поддерживаемые действия:' : 'Supported actions:'}
            </span>
            {manifest.actions.map((act: string) => (
              <span class="px-2.5 py-1 rounded-md bg-[oklch(0.16_0_0)] text-[#00e0cb] font-mono text-xs font-medium">
                {act}
              </span>
            ))}
          </div>
        )}
      </div>

      <!-- Quick Install Snippet -->
      <div class="card-surface p-5 space-y-2">
        <div class="flex items-center justify-between text-xs font-mono text-[oklch(0.6_0_0)]">
          <span>{lang === 'ru' ? 'Быстрая установка в ядро SaviorBill' : 'Quick install into SaviorBill'}</span>
          <button 
            type="button" 
            id="copy-install-cmd" 
            data-cmd={`curl -fsSL https://saviorbill.com/downloads/hub/${slug}.zip -o ${slug}.zip`}
            class="text-[#009080] hover:text-[#00e0cb] cursor-pointer"
          >
            {lang === 'ru' ? 'Копировать' : 'Copy'}
          </button>
        </div>
        <div class="bg-[oklch(0.12_0_0)] p-3 rounded-lg font-mono text-xs text-white overflow-x-auto select-all">
          curl -fsSL https://saviorbill.com/downloads/hub/{slug}.zip -o {slug}.zip
        </div>
      </div>

      <!-- Row of File Buttons (replacing old full code blocks) -->
      {sourceFiles.length > 0 && (
        <div class="card-surface p-4 sm:p-5 space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 text-xs font-mono text-[oklch(0.6_0_0)]">
              <svg class="size-4 text-[#009080]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
              <span class="font-semibold text-white">
                {lang === 'ru' ? 'Исходные файлы модуля' : 'Module Source Files'}
              </span>
            </div>
            <span class="text-xs font-mono text-[oklch(0.5_0_0)]">
              {sourceFiles.length} {lang === 'ru' ? 'файла(-ов)' : 'file(s)'}
            </span>
          </div>

          <div class="flex flex-wrap items-center gap-2.5">
            {sourceFiles.map((file) => {
              const isLua = file.endsWith('.lua');
              const isJson = file.endsWith('.json');
              const ext = file.split('.').pop()?.toUpperCase() || '';
              return (
                <a
                  href={`/${lang}/hub/${slug}/${file}`}
                  class="group h-10 px-3.5 sm:px-4 rounded-xl bg-[oklch(0.16_0_0)] hover:bg-[oklch(0.22_0_0)] text-neutral-200 hover:text-white text-xs font-mono inline-flex items-center gap-2.5 border border-[oklch(1_0_0/8%)] hover:border-[#009080]/50 transition-all shadow-xs"
                >
                  <span class={`px-1.5 py-0.5 rounded text-[10px] font-bold ${
                    isLua 
                      ? 'bg-[#009080]/20 text-[#00e0cb]' 
                      : isJson 
                        ? 'bg-amber-500/20 text-amber-300' 
                        : 'bg-neutral-700 text-neutral-300'
                  }`}>
                    {isLua ? 'LUA' : isJson ? 'JSON' : ext}
                  </span>
                  <span class="font-medium group-hover:text-[#00e0cb] transition-colors">{file}</span>
                  <svg class="size-3.5 text-[oklch(0.5_0_0)] group-hover:text-[#00e0cb] group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              );
            })}
          </div>
        </div>
      )}

      <!-- Formatted README Documentation -->
      {readmeHtml && (
        <div class="card-surface p-6 sm:p-10 space-y-4">
          <div class="article-content" set:html={readmeHtml} />
        </div>
      )}

    </div>
  </div>

  <MediaLightbox client:load />
  <ArticleQuoteAndAnchors lang={lang} />
</BaseLayout>

<script is:inline>
  (function() {
    function bindCopy() {
      const cmdBtn = document.getElementById('copy-install-cmd');
      if (cmdBtn) {
        cmdBtn.addEventListener('click', () => {
          const cmd = cmdBtn.getAttribute('data-cmd');
          if (cmd) {
            navigator.clipboard.writeText(cmd).then(() => {
              const orig = cmdBtn.textContent;
              cmdBtn.textContent = '✓ Скопировано!';
              setTimeout(() => { cmdBtn.textContent = orig; }, 1500);
            });
          }
        });
      }
    }

    bindCopy();
    document.addEventListener('astro:page-load', bindCopy);
    document.addEventListener('astro:after-swap', bindCopy);
  })();
</script>
