---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import communityScripts from '../../../data/community-scripts.json';

export function getStaticPaths() {
  return [
    { params: { lang: 'ru' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params as { lang: 'ru' | 'en' };

// Load official scripts
const hubDir = path.resolve('src/content/hub');
const officialScripts: any[] = [];

if (fs.existsSync(hubDir)) {
  const dirs = fs.readdirSync(hubDir, { withFileTypes: true });
  for (const d of dirs) {
    if (d.isDirectory()) {
      const mPath = path.join(hubDir, d.name, 'manifest.json');
      if (fs.existsSync(mPath)) {
        try {
          const m = JSON.parse(fs.readFileSync(mPath, 'utf-8'));
          officialScripts.push({ ...m, isOfficial: true });
        } catch (e) {}
      }
    }
  }
}

const title = lang === 'ru' ? 'Каталог Lua-скриптов и интеграций' : 'Lua Scripts & Integrations Hub';
const description = lang === 'ru'
  ? 'Открытый реестр модулей выдачи услуг, эквайрингов и манифестов Server-Driven UI (sbuiSDK) для SaviorBill.'
  : 'Open catalog of service delivery modules, payment gateways, and sbuiSDK manifests for SaviorBill.';
---

<BaseLayout title={title} description={description} lang={lang}>
  <div class="px-3 sm:px-4 py-12 sm:py-16">
    <div class="max-w-6xl mx-auto space-y-10">
      
      <!-- Top Title Group -->
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <div class="badge-pill inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-semibold">
          Lua 5.4 & sbuiSDK Ecosystem
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          {title}
        </h1>
        <p class="text-[oklch(0.65_0_0)] text-sm sm:text-base leading-relaxed">
          {description}
        </p>
      </div>

      <!-- Controls Row: Count Badge & Search Filter -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-[oklch(0.18_0_0)] card-surface select-none self-start sm:self-auto text-xs font-mono">
          <span class="size-2 rounded-full bg-[#009080]"></span>
          <span class="font-semibold text-white">
            {lang === 'ru' ? 'Официальные модули' : 'Official Modules'}
          </span>
          <span class="text-[oklch(0.6_0_0)]">({officialScripts.length})</span>
        </div>

        <!-- Search Bar -->
        <div class="relative w-full sm:w-72">
          <input
            type="text"
            id="hub-search-input"
            placeholder={lang === 'ru' ? 'Поиск модулей...' : 'Search scripts...'}
            autocomplete="off"
            class="w-full h-10 pl-9 pr-3 rounded-xl bg-[oklch(0.18_0_0)] text-xs text-white placeholder-[oklch(0.55_0_0)] focus:outline-none focus:ring-1 focus:ring-[#009080] transition-all card-surface"
          />
          <svg class="size-4 text-[oklch(0.55_0_0)] absolute left-3 top-3 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

      </div>

      <!-- Section: Official Scripts -->
      <div id="hub-list-official" class="hub-list grid grid-cols-1 md:grid-cols-2 gap-5">
        {officialScripts.map((s) => (
          <a
            href={`/${lang}/hub/${s.id}`}
            data-hub-card
            data-search-text={`${s.name} ${s.description} ${s.category} ${(s.actions || []).join(' ')}`.toLowerCase()}
            class="group card-interactive p-5 flex flex-col justify-between rounded-xl relative overflow-hidden transition-all duration-200"
          >
            <div class="space-y-3">
              <!-- Top Badges & Version -->
              <div class="flex items-center justify-between gap-2 text-xs font-mono">
                <div class="flex items-center gap-2">
                  <span class="badge-pill px-2.5 py-0.5 rounded text-[11px] font-semibold">
                    {s.category}
                  </span>
                  <span class="text-[oklch(0.55_0_0)]">v{s.version}</span>
                </div>
                <span class="text-[11px] text-[#009080] font-semibold flex items-center gap-1">
                  <span class="size-1.5 rounded-full bg-[#009080]"></span>
                  <span>Verified</span>
                </span>
              </div>

              <!-- Title (Gist-like compact 1-line) -->
              <h3 class="text-base font-bold text-white group-hover:text-[#009080] transition-colors leading-snug">
                {s.name}
              </h3>

              <!-- Description (2 lines max) -->
              <p class="text-xs text-[oklch(0.65_0_0)] leading-relaxed line-clamp-2">
                {s.description}
              </p>

              <!-- Actions tags -->
              {s.actions && s.actions.length > 0 && (
                <div class="flex flex-wrap items-center gap-1.5 pt-1">
                  {s.actions.map((act: string) => (
                    <span class="px-2 py-0.5 rounded bg-[oklch(0.16_0_0)] text-[oklch(0.85_0_0)] font-mono text-[10px]">
                      {act}
                    </span>
                  ))}
                </div>
              )}
            </div>

            <!-- Footer: Download Button & Link -->
            <div class="pt-4 mt-4 border-t border-[oklch(1_0_0/5%)] flex items-center justify-between">
              <span class="text-xs text-[#009080] font-medium group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                <span>{lang === 'ru' ? 'Исходный код и дока' : 'Source & Docs'}</span>
                <span>→</span>
              </span>

              <!-- Direct download button on the card -->
              <button
                type="button"
                data-download-url={`/downloads/hub/${s.id}.zip`}
                class="hub-direct-download-btn px-3 py-1.5 rounded-lg bg-[oklch(0.24_0_0)] hover:bg-[#009080] text-white text-xs font-semibold inline-flex items-center gap-1.5 transition-colors shadow-xs"
              >
                <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>.zip</span>
              </button>
            </div>
          </a>
        ))}
      </div>

      <!-- No Results State -->
      <div id="hub-no-results" class="hidden text-center py-16 space-y-2">
        <p class="text-base font-semibold text-white">
          {lang === 'ru' ? 'Модули не найдены' : 'No modules found'}
        </p>
        <p class="text-xs text-[oklch(0.6_0_0)]">
          {lang === 'ru' ? 'Попробуйте изменить поисковый запрос.' : 'Try adjusting your search query.'}
        </p>
      </div>

    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function() {
    function initHub() {
      const tabOfficial = document.getElementById('tab-btn-official');
      const tabCommunity = document.getElementById('tab-btn-community');
      const listOfficial = document.getElementById('hub-list-official');
      const listCommunity = document.getElementById('hub-list-community');
      const searchInput = document.getElementById('hub-search-input');
      const noResults = document.getElementById('hub-no-results');

      // 1. Direct download buttons stop propagation so card link isn't clicked
      document.querySelectorAll('.hub-direct-download-btn').forEach((btn) => {
        if (btn.dataset.bound) return;
        btn.dataset.bound = 'true';
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const url = btn.getAttribute('data-download-url');
          if (url) {
            const a = document.createElement('a');
            a.href = url;
            a.download = '';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
          }
        });
      });

      // 2. Tab switching logic
      if (tabOfficial && tabCommunity && listOfficial && listCommunity) {
        tabOfficial.addEventListener('click', () => {
          tabOfficial.classList.add('bg-[#009080]', 'text-white');
          tabOfficial.classList.remove('text-[oklch(0.7_0_0)]');
          tabCommunity.classList.remove('bg-[#009080]', 'text-white');
          tabCommunity.classList.add('text-[oklch(0.7_0_0)]');

          listOfficial.classList.remove('hidden');
          listOfficial.classList.add('grid');
          listCommunity.classList.add('hidden');
          listCommunity.classList.remove('grid');

          if (searchInput) searchInput.dispatchEvent(new Event('input'));
        });

        tabCommunity.addEventListener('click', () => {
          tabCommunity.classList.add('bg-[#009080]', 'text-white');
          tabCommunity.classList.remove('text-[oklch(0.7_0_0)]');
          tabOfficial.classList.remove('bg-[#009080]', 'text-white');
          tabOfficial.classList.add('text-[oklch(0.7_0_0)]');

          listCommunity.classList.remove('hidden');
          listCommunity.classList.add('grid');
          listOfficial.classList.add('hidden');
          listOfficial.classList.remove('grid');

          if (searchInput) searchInput.dispatchEvent(new Event('input'));
        });
      }

      // 3. Search filtering logic
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          const q = e.target.value.toLowerCase().trim();
          const activeList = listOfficial && !listOfficial.classList.contains('hidden') ? listOfficial : listCommunity;
          if (!activeList) return;

          const cards = activeList.querySelectorAll('[data-hub-card]');
          let visibleCount = 0;

          cards.forEach((card) => {
            const text = (card.getAttribute('data-search-text') || '').toLowerCase();
            if (!q || text.includes(q)) {
              card.style.display = '';
              visibleCount++;
            } else {
              card.style.display = 'none';
            }
          });

          if (noResults) {
            if (visibleCount === 0 && q) {
              noResults.classList.remove('hidden');
            } else {
              noResults.classList.add('hidden');
            }
          }
        });
      }
    }

    initHub();
    document.addEventListener('astro:page-load', initHub);
    document.addEventListener('astro:after-swap', initHub);
  })();
</script>
