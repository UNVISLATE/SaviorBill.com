---
import fs from 'node:fs';
import path from 'node:path';
import HubFileView from '../../../../views/HubFileView.astro';

export function getStaticPaths() {
  const languages: ('en')[] = ['en'];
  const hubDir = path.resolve('src/content/hub');
  if (!fs.existsSync(hubDir)) return [];

  const paths: { params: { lang: 'en'; slug: string; filename: string } }[] = [];

  const dirs = fs.readdirSync(hubDir, { withFileTypes: true });
  for (const d of dirs) {
    if (!d.isDirectory()) continue;
    const slug = d.name;
    const scriptDir = path.join(hubDir, slug);
    const files = fs.readdirSync(scriptDir)
      .filter((f) => !f.toLowerCase().startsWith('readme') && !f.startsWith('.') && !f.endsWith('.zip'));

    for (const lang of languages) {
      for (const filename of files) {
        paths.push({
          params: { lang, slug, filename }
        });
      }
    }
  }

  return paths;
}

const { lang, slug, filename } = Astro.params as { lang: 'ru' | 'en'; slug: string; filename: string };
---

<HubFileView lang={lang} slug={slug} filename={filename} />
