---
import RepoReleasesView from '../../../views/RepoReleasesView.astro';
import repositories from '../../../data/repositories.json';

export function getStaticPaths() {
  return repositories.map((r) => ({
    params: { lang: 'en', repo: r.id }
  }));
}

const { lang, repo } = Astro.params as { lang: 'ru' | 'en'; repo: string };
---

<RepoReleasesView lang={lang} repoId={repo} />
