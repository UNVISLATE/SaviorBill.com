---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import SeoMeta from '../components/common/SeoMeta.astro';
import AmbientBackground from '../components/common/AmbientBackground.astro';
import CurtainTransition from '../components/common/CurtainTransition.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: 'ru' | 'en';
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  type?: 'website' | 'article';
  image?: string;
}

const { title, description, lang = 'ru', jsonLd, type = 'website', image } = Astro.props;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SeoMeta 
      title={title} 
      description={description} 
      lang={lang} 
      type={type} 
      jsonLd={jsonLd}
      image={image}
    />
    <script is:inline>
      (function() {
        function getSavedTheme() {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') return saved;
          return 'dark';
        }
        function applySavedTheme() {
          const theme = getSavedTheme();
          if (theme === 'light') {
            document.documentElement.classList.add('light');
            document.documentElement.classList.remove('dark');
          } else {
            document.documentElement.classList.add('dark');
            document.documentElement.classList.remove('light');
          }
        }
        applySavedTheme();
        document.addEventListener('astro:after-swap', applySavedTheme);
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col antialiased relative">
    <CurtainTransition />
    <AmbientBackground />
    <Header lang={lang} />
    <main class="flex-1" style="view-transition-name: page;">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
