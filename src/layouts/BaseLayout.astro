---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import SeoMeta from '../components/common/SeoMeta.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: 'ru' | 'en';
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  type?: 'website' | 'article';
  image?: string;
}

const { title, description, lang = 'ru', jsonLd, type = 'website', image } = Astro.props;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SeoMeta 
      title={title} 
      description={description} 
      lang={lang} 
      type={type} 
      jsonLd={jsonLd}
      image={image}
    />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-[oklch(0.145_0_0)] text-[oklch(0.985_0_0)] antialiased">
    <Header lang={lang} />
    <main class="flex-1" style="view-transition-name: page;">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
