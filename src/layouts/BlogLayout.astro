---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/docs/TableOfContents.astro';
import MediaLightbox from '../components/blog/MediaLightbox';
import HubCardMount from '../components/hub/HubCardMount';
import ArticleQuoteAndAnchors from '../components/common/ArticleQuoteAndAnchors.astro';
import { getLocalePath } from '../i18n/ui';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface FaqItem {
  question: string;
  answer: string;
}

export interface PostMeta {
  slug: string;
  title: string;
  description: string;
  cover: string;
  date: string | Date;
  author?: string;
  authorAvatar?: string;
  tags?: string[];
}

interface Props {
  title: string;
  description: string;
  lang: 'ru' | 'en';
  date: string | Date;
  author?: string;
  authorAvatar?: string;
  tags?: string[];
  slug: string;
  headings: Heading[];
  faq?: FaqItem[];
  cover?: string;
  prevPost?: PostMeta | null;
  nextPost?: PostMeta | null;
  relatedPosts?: PostMeta[];
}

const {
  title,
  description,
  lang,
  date,
  author = 'Andrey UNVI',
  authorAvatar = '/images/avatars/andrey-unvi.jpg',
  tags = [],
  slug,
  headings,
  faq = [],
  cover,
  prevPost,
  nextPost,
  relatedPosts = []
} = Astro.props;

const dateStr = typeof date === 'string' ? date : date.toISOString().split('T')[0];
const postUrl = `https://saviorbill.com${getLocalePath(`/blog/${slug}`, lang)}`;
const resolvedCover = cover || `/images/og/${lang}-${slug}.png`;
const absoluteCoverUrl = resolvedCover.startsWith('http') ? resolvedCover : `https://saviorbill.com${resolvedCover}`;

const jsonLd: Array<Record<string, any>> = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${postUrl}#article`,
    'headline': title,
    'description': description,
    'image': absoluteCoverUrl,
    'url': postUrl,
    'datePublished': dateStr,
    'author': {
      '@type': 'Person',
      'name': author,
      'url': 'https://unvi.xyz'
    },
    'publisher': {
      '@type': 'Organization',
      'name': 'SaviorBill',
      'url': 'https://saviorbill.com'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'SaviorBill',
        'item': `https://saviorbill.com${getLocalePath('/', lang)}`
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': lang === 'ru' ? 'Блог' : 'Blog',
        'item': `https://saviorbill.com${getLocalePath('/blog', lang)}`
      },
      {
        '@type': 'ListItem',
        'position': 3,
        'name': title,
        'item': postUrl
      }
    ]
  }
];

if (faq && faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': faq.map((item) => ({
      '@type': 'Question',
      'name': item.question,
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': item.answer
      }
    }))
  });
}
---

<BaseLayout 
  title={title} 
  description={description} 
  lang={lang} 
  type="article" 
  jsonLd={jsonLd}
  image={absoluteCoverUrl}
>
  <!-- Aligned strictly to max-w-6xl like Header -->
  <div class="px-3 sm:px-4 py-6 sm:py-10">
    <div class="max-w-6xl mx-auto flex gap-8 justify-center items-start">
      
      <!-- Main Article Column (flex-1) -->
      <article class="flex-1 min-w-0 max-w-3xl" id="blog-article-content">
        <!-- Breadcrumbs -->
        <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 text-xs font-mono text-[oklch(0.55_0_0)] mb-4 article-breadcrumbs">
          <a href={getLocalePath('/', lang)} class="hover:text-[#009080] transition-colors">SaviorBill</a>
          <span>/</span>
          <a href={getLocalePath('/blog', lang)} class="hover:text-[#009080] transition-colors">
            {lang === 'ru' ? 'Блог' : 'Blog'}
          </a>
          <span>/</span>
          <span class="text-[#009080] truncate max-w-[140px] sm:max-w-xs">{title}</span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight mb-4 leading-tight article-main-title break-words">
          {title}
        </h1>

        <!-- Meta Header -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-4 text-xs font-mono pb-6 mb-6 border-b border-[oklch(1_0_0/6%)] article-meta-bar">
          <div class="flex items-center gap-2">
            {authorAvatar ? (
              <img 
                src={authorAvatar} 
                alt={author} 
                class="size-6 rounded-full object-cover shrink-0 ring-1 ring-[#009080]/30 shadow-xs" 
              />
            ) : (
              <span class="size-6 rounded-full bg-[#009080] text-white flex items-center justify-center font-bold text-[10px]">
                {author[0]}
              </span>
            )}
            <span class="font-medium article-author-name">{author}</span>
          </div>
          <span>•</span>
          <time datetime={dateStr} class="article-date">{dateStr}</time>
          {tags.length > 0 && (
            <>
              <span>•</span>
              <div class="flex flex-wrap items-center gap-1.5">
                {tags.map((tag) => (
                  <span class="badge-pill px-2.5 py-0.5 rounded text-[11px] font-mono font-semibold">
                    #{tag}
                  </span>
                ))}
              </div>
            </>
          )}
        </div>

        <!-- Featured Cover Image (Arayas style directly below header) -->
        <div class="aspect-video w-full rounded-2xl overflow-hidden bg-[oklch(0.14_0_0)] mb-8 shadow-xl">
          <img 
            src={resolvedCover} 
            alt={title} 
            class="w-full h-full object-cover" 
          />
        </div>

        <!-- Markdown Body -->
        <div class="article-content">
          <slot />
        </div>

        <!-- FAQ Section: Collapsible Accordions (as requested) -->
        {faq && faq.length > 0 && (
          <div class="mt-14 pt-8 border-t border-[oklch(1_0_0/6%)] space-y-4 faq-container">
            <h2 class="text-xl sm:text-2xl font-bold mb-4 faq-section-title">
              {lang === 'ru' ? 'Часто задаваемые вопросы (FAQ)' : 'Frequently Asked Questions (FAQ)'}
            </h2>
            <div class="space-y-3">
              {faq.map((item) => (
                <details class="group card-surface p-4 select-none">
                  <summary class="flex items-center justify-between cursor-pointer list-none text-sm sm:text-base font-semibold group-open:text-[#009080] transition-colors faq-question">
                    <span>{item.question}</span>
                    <svg class="size-4 shrink-0 transition-transform duration-200 group-open:rotate-180 opacity-70 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </summary>
                  <p class="mt-3 text-xs sm:text-sm leading-relaxed pt-2 border-t border-[oklch(1_0_0/4%)] faq-answer">
                    {item.answer}
                  </p>
                </details>
              ))}
            </div>
          </div>
        )}

        <!-- Prev / Next Navigation with Small Thumbnails -->
        {(prevPost || nextPost) && (
          <div class="mt-14 pt-8 border-t border-[oklch(1_0_0/6%)] grid grid-cols-1 sm:grid-cols-2 gap-4">
            {prevPost ? (
              <a
                href={getLocalePath(`/blog/${prevPost.slug}`, lang)}
                class="card-interactive p-3.5 sm:p-4 flex items-center gap-3.5 group rounded-xl"
              >
                <div class="size-14 sm:size-16 rounded-lg overflow-hidden bg-[oklch(0.14_0_0)] shrink-0 relative">
                  <img
                    src={prevPost.cover}
                    alt={prevPost.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
                <div class="min-w-0 flex-1">
                  <span class="text-[11px] font-mono text-[#009080] font-semibold flex items-center gap-1 mb-1">
                    ← {lang === 'ru' ? 'Предыдущая статья' : 'Previous article'}
                  </span>
                  <div class="text-xs sm:text-sm font-bold group-hover:text-[#009080] transition-colors line-clamp-2 leading-snug">
                    {prevPost.title}
                  </div>
                </div>
              </a>
            ) : <div class="hidden sm:block"></div>}

            {nextPost ? (
              <a
                href={getLocalePath(`/blog/${nextPost.slug}`, lang)}
                class="card-interactive p-3.5 sm:p-4 flex items-center justify-between gap-3.5 group rounded-xl text-right sm:text-right"
              >
                <div class="min-w-0 flex-1">
                  <span class="text-[11px] font-mono text-[#009080] font-semibold flex items-center justify-end gap-1 mb-1">
                    {lang === 'ru' ? 'Следующая статья' : 'Next article'} →
                  </span>
                  <div class="text-xs sm:text-sm font-bold group-hover:text-[#009080] transition-colors line-clamp-2 leading-snug">
                    {nextPost.title}
                  </div>
                </div>
                <div class="size-14 sm:size-16 rounded-lg overflow-hidden bg-[oklch(0.14_0_0)] shrink-0 relative">
                  <img
                    src={nextPost.cover}
                    alt={nextPost.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
              </a>
            ) : <div></div>}
          </div>
        )}

        <!-- Related Posts Section (Похожие статьи) -->
        {relatedPosts && relatedPosts.length > 0 && (
          <div class="mt-14 pt-8 border-t border-[oklch(1_0_0/6%)] space-y-6">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-xl sm:text-2xl font-bold tracking-tight mb-1">
                  {lang === 'ru' ? 'Похожие статьи' : 'Related Articles'}
                </h3>
                <p class="text-xs sm:text-sm text-[oklch(0.65_0_0)]">
                  {lang === 'ru' ? 'Материалы по смежным темам, архитектуре и практике внедрения.' : 'More articles on related topics, architecture, and guides.'}
                </p>
              </div>
              <a
                href={getLocalePath('/blog', lang)}
                class="text-xs font-mono font-semibold text-[#009080] hover:text-[#0c5e53] transition-colors hidden sm:inline-flex items-center gap-1"
              >
                <span>{lang === 'ru' ? 'Все статьи' : 'All articles'}</span>
                <span>→</span>
              </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
              {relatedPosts.map((rPost) => {
                const dateText = typeof rPost.date === 'string' ? rPost.date : rPost.date.toISOString().split('T')[0];
                return (
                  <a
                    href={getLocalePath(`/blog/${rPost.slug}`, lang)}
                    class="group card-interactive p-4 sm:p-5 flex flex-col justify-between rounded-xl"
                  >
                    <div>
                      <div class="aspect-video w-full rounded-lg overflow-hidden bg-[oklch(0.14_0_0)] mb-3 relative">
                        <img
                          src={rPost.cover}
                          alt={rPost.title}
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                          loading="lazy"
                        />
                      </div>
                      {rPost.tags && rPost.tags.length > 0 && (
                        <div class="flex flex-wrap items-center gap-1.5 mb-2">
                          {rPost.tags.slice(0, 2).map((tag: string) => (
                            <span class="badge-pill px-2 py-0.5 rounded text-[10px] font-mono font-semibold">
                              #{tag}
                            </span>
                          ))}
                        </div>
                      )}
                      <h4 class="text-sm sm:text-base font-bold group-hover:text-[#009080] transition-colors line-clamp-2 leading-snug mb-2">
                        {rPost.title}
                      </h4>
                      <p class="text-xs text-[oklch(0.65_0_0)] line-clamp-2 leading-relaxed mb-4">
                        {rPost.description}
                      </p>
                    </div>

                    <div class="pt-3 border-t border-[oklch(1_0_0/5%)] flex items-center justify-between text-xs font-mono text-[oklch(0.55_0_0)]">
                      <time datetime={dateText}>{dateText}</time>
                      <span class="text-[#009080] font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                        {lang === 'ru' ? 'Читать' : 'Read'} →
                      </span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        )}

      </article>

      <!-- Right: Sticky TOC Sidebar (w-64) -->
      <div class="hidden xl:block w-64 shrink-0 sticky top-20">
        <TableOfContents headings={headings} />
      </div>

    </div>
  </div>

  <!-- Interactive Lightbox for Markdown Images & Galleries -->
  <MediaLightbox client:load />
  <!-- Interactive Hub Card Hydrator -->
  <HubCardMount client:load />

  <ArticleQuoteAndAnchors lang={lang} />
</BaseLayout>
