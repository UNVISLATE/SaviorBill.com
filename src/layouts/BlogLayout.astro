---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/docs/TableOfContents.astro';
import MediaLightbox from '../components/blog/MediaLightbox';
import HubCardMount from '../components/hub/HubCardMount';
import ArticleQuoteAndAnchors from '../components/common/ArticleQuoteAndAnchors.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface FaqItem {
  question: string;
  answer: string;
}

interface SiblingPost {
  title: string;
  slug: string;
  cover?: string;
}

interface Props {
  title: string;
  description: string;
  lang: 'ru' | 'en';
  date: string | Date;
  author?: string;
  authorAvatar?: string;
  tags?: string[];
  slug: string;
  headings: Heading[];
  faq?: FaqItem[];
  cover?: string;
  prevPost?: SiblingPost;
  nextPost?: SiblingPost;
}

const {
  title,
  description,
  lang,
  date,
  author = 'Andrey UNVI',
  authorAvatar = '/images/avatars/andrey-unvi.jpg',
  tags = [],
  slug,
  headings,
  faq = [],
  cover,
  prevPost,
  nextPost
} = Astro.props;

const dateStr = typeof date === 'string' ? date : date.toISOString().split('T')[0];
const postUrl = `https://saviorbill.com/${lang}/blog/${slug}`;
const resolvedCover = cover || `/images/og/${lang}-${slug}.svg`;
const absoluteCoverUrl = resolvedCover.startsWith('http') ? resolvedCover : `https://saviorbill.com${resolvedCover}`;

const jsonLd: Array<Record<string, any>> = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${postUrl}#article`,
    'headline': title,
    'description': description,
    'image': absoluteCoverUrl,
    'url': postUrl,
    'datePublished': dateStr,
    'author': {
      '@type': 'Person',
      'name': author,
      'url': 'https://unvi.xyz'
    },
    'publisher': {
      '@type': 'Organization',
      'name': 'SaviorBill',
      'url': 'https://saviorbill.com'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'SaviorBill',
        'item': `https://saviorbill.com/${lang}`
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': lang === 'ru' ? 'Блог' : 'Blog',
        'item': `https://saviorbill.com/${lang}/blog`
      },
      {
        '@type': 'ListItem',
        'position': 3,
        'name': title,
        'item': postUrl
      }
    ]
  }
];

if (faq && faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': faq.map((item) => ({
      '@type': 'Question',
      'name': item.question,
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': item.answer
      }
    }))
  });
}
---

<BaseLayout 
  title={title} 
  description={description} 
  lang={lang} 
  type="article" 
  jsonLd={jsonLd}
  image={absoluteCoverUrl}
>
  <!-- Aligned strictly to max-w-6xl like Header -->
  <div class="px-3 sm:px-4 py-10">
    <div class="max-w-6xl mx-auto flex gap-8 justify-center items-start">
      
      <!-- Main Article Column (flex-1) -->
      <article class="flex-1 min-w-0 max-w-3xl" id="blog-article-content">
        <!-- Breadcrumbs -->
        <div class="flex items-center gap-2 text-xs font-mono text-[oklch(0.55_0_0)] mb-4 article-breadcrumbs">
          <a href={`/${lang}`} class="hover:text-[#009080] transition-colors">SaviorBill</a>
          <span>/</span>
          <a href={`/${lang}/blog`} class="hover:text-[#009080] transition-colors">
            {lang === 'ru' ? 'Блог' : 'Blog'}
          </a>
          <span>/</span>
          <span class="text-[#009080] truncate max-w-xs">{title}</span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight mb-4 leading-tight article-main-title">
          {title}
        </h1>

        <!-- Meta Header -->
        <div class="flex flex-wrap items-center gap-4 text-xs font-mono pb-6 mb-6 border-b border-[oklch(1_0_0/6%)] article-meta-bar">
          <div class="flex items-center gap-2">
            {authorAvatar ? (
              <img 
                src={authorAvatar} 
                alt={author} 
                class="size-6 rounded-full object-cover shrink-0 ring-1 ring-[#009080]/30 shadow-xs" 
              />
            ) : (
              <span class="size-6 rounded-full bg-[#009080] text-white flex items-center justify-center font-bold text-[10px]">
                {author[0]}
              </span>
            )}
            <span class="font-medium article-author-name">{author}</span>
          </div>
          <span>•</span>
          <time datetime={dateStr} class="article-date">{dateStr}</time>
          {tags.length > 0 && (
            <>
              <span>•</span>
              <div class="flex items-center gap-1.5">
                {tags.map((tag) => (
                  <span class="badge-pill px-2.5 py-0.5 rounded text-[11px] font-mono font-semibold">
                    #{tag}
                  </span>
                ))}
              </div>
            </>
          )}
        </div>

        <!-- Featured Cover Image (Arayas style directly below header) -->
        <div class="aspect-video w-full rounded-2xl overflow-hidden bg-[oklch(0.14_0_0)] mb-8 shadow-xl">
          <img 
            src={resolvedCover} 
            alt={title} 
            class="w-full h-full object-cover" 
          />
        </div>

        <!-- Markdown Body -->
        <div class="article-content">
          <slot />
        </div>

        <!-- FAQ Section: Collapsible Accordions (as requested) -->
        {faq && faq.length > 0 && (
          <div class="mt-14 pt-8 border-t border-[oklch(1_0_0/6%)] space-y-4 faq-container">
            <h2 class="text-xl sm:text-2xl font-bold mb-4 faq-section-title">
              {lang === 'ru' ? 'Часто задаваемые вопросы (FAQ)' : 'Frequently Asked Questions (FAQ)'}
            </h2>
            <div class="space-y-3">
              {faq.map((item) => (
                <details class="group card-surface p-4 select-none">
                  <summary class="flex items-center justify-between cursor-pointer list-none text-sm sm:text-base font-semibold group-open:text-[#009080] transition-colors faq-question">
                    <span>{item.question}</span>
                    <svg class="size-4 shrink-0 transition-transform duration-200 group-open:rotate-180 opacity-70 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </summary>
                  <p class="mt-3 text-xs sm:text-sm leading-relaxed pt-2 border-t border-[oklch(1_0_0/4%)] faq-answer">
                    {item.answer}
                  </p>
                </details>
              ))}
            </div>
          </div>
        )}

        <!-- Sibling / Related Posts (Links to other articles at bottom) -->
        <div class="mt-14 pt-8 border-t border-[oklch(1_0_0/6%)] related-posts-container">
          <div class="font-mono text-xs uppercase tracking-wider mb-4 font-semibold related-posts-header">
            {lang === 'ru' ? 'Другие статьи в блоге' : 'More from the blog'}
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {slug === 'self-hosted-billing-fastapi-lua' ? (
              <a
                href={`/${lang}/blog/vpn-sales-yookassa-marzban`}
                class="card-interactive p-4 flex flex-col justify-between"
              >
                <span class="text-xs text-[#009080] font-mono mb-1">{lang === 'ru' ? 'Следующая статья →' : 'Next article →'}</span>
                <span class="text-sm font-semibold leading-snug related-post-title">
                  {lang === 'ru' ? 'Как запустить продажи VPN через ЮKassa и Marzban' : 'How to Launch a VPN Service with YooKassa and Marzban'}
                </span>
              </a>
            ) : (
              <a
                href={`/${lang}/blog/self-hosted-billing-fastapi-lua`}
                class="card-interactive p-4 flex flex-col justify-between"
              >
                <span class="text-xs text-[#009080] font-mono mb-1">{lang === 'ru' ? '← Архитектура биллинга' : '← Billing Architecture'}</span>
                <span class="text-sm font-semibold leading-snug related-post-title">
                  {lang === 'ru' ? 'Изоляция логики на Lua и Server-Driven UI' : 'Isolating Logic in Lua and Server-Driven UI'}
                </span>
              </a>
            )}
            <a
              href={`/${lang}/docs/quickstart`}
              class="card-interactive p-4 flex flex-col justify-between"
            >
              <span class="text-xs text-[#009080] font-mono mb-1">{lang === 'ru' ? 'Документация →' : 'Documentation →'}</span>
              <span class="text-sm font-semibold leading-snug related-post-title">
                {lang === 'ru' ? 'Быстрый старт и развертывание SaviorBill' : 'Quickstart and Deploying SaviorBill'}
              </span>
            </a>
          </div>
        </div>

      </article>

      <!-- Right: Sticky TOC Sidebar (w-64) -->
      <div class="hidden xl:block w-64 shrink-0 sticky top-20">
        <TableOfContents headings={headings} />
      </div>

    </div>
  </div>

  <!-- Interactive Lightbox for Markdown Images & Galleries -->
  <MediaLightbox client:load />
  <!-- Interactive Hub Card Hydrator -->
  <HubCardMount client:load />

  <ArticleQuoteAndAnchors lang={lang} />
</BaseLayout>
